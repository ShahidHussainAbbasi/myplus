# Node / npm (Cypress tooling) — never commit vendored deps
node_modules/

# Application logs (root + per-service)
*.log
*.log.err

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.ear

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

target/

# Eclipse
.settings/
*.project
*.classpath
.prefs
*.prefs
.metadata/
.factorypath

# Intellij
.idea/
*.iml
*.iws

# Cypress run artifacts (reproducible via the specs / npm scripts)
cypress/videos/
cypress/screenshots/
cypress/downloads/

# Local secrets (DB creds, etc.) — never commit
.env
.env.local
*.env
*.env.local
# ...and any BACKUP of one. A timestamped copy (.env.bak-081158, .env.save, .env.orig) carries the
# same DB_PASSWORD / JWT_SECRET / INTERNAL_SECRET as the original but matched none of the patterns
# above, so `git add -A` staged it. Caught before it was committed; these keep it that way.
.env.bak*
.env.*.bak
*.env.bak*
.env.save
.env.orig
!.env.example

# Service runtime logs (not versioned)
microservices/logs/
node_modules
 c
# Local DB dumps / backups — never commit
u5-backups/
*-backups/
*.sql.bak

# Saved browser pages dropped in the REPO ROOT ("Save page as" of a walkthrough, report or status board).
# 22 bundles — 106 files, ~8 MB — were tracked this way across ~12 commits from 2026-07-28 to 2026-09-16, each
# swept in by `git commit -a`. They are captures of generated pages: nothing in the build, the specs or the docs
# references them, and they are re-creatable from the page they came from. Kept locally, untracked from 2026-09-16.
# Scoped to the root (leading slash) so templates under src/main/resources/templates are untouched.
/*.html
/*_files/
