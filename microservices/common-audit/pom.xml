<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.myplus</groupId>
    <artifactId>myplus-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>common-audit</artifactId>
  <name>common-audit</name>
  <description>E4 — the shared audit PRODUCER: enqueue in the caller's transaction, deliver after commit,
    re-drive with the shared OutboxRelay. Extracted at the second consumer (business-service was the first,
    auth-service the second) per the standing rule, so the two do not drift on the part that matters most —
    when a row is written relative to the commit that justifies it.

    Holds NO @Entity: AbstractAuditOutbox is a @MappedSuperclass, so every service still owns its own
    audit_outbox table and its own migration, per the microservice schema-ownership standard. What is shared is
    the column set and the delivery behaviour, not the table.</description>

  <!-- `provided` for everything a Boot service already ships. jakarta.persistence-api is needed at COMPILE time
       for the @MappedSuperclass column mapping and arrives via spring-boot-starter-data-jpa in every consumer.
       ⚠ auth-service and api-gateway extend the ROOT aggregator, not service-parent, so they inherit none of
       these — checked against auth-service's pom before this module was added: starter-web, starter-data-jpa,
       common-security and commerce-contracts are all already declared there. -->
  <dependencies>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-outbox</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>commerce-contracts</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>

    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-tx</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>jakarta.persistence</groupId><artifactId>jakarta.persistence-api</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId><scope>provided</scope></dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>
</project>
