<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.myplus</groupId>
    <artifactId>myplus-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>api-gateway</artifactId>

  <dependencies>
    <!--
      Spring Cloud LoadBalancer's production cache.
      ────────────────────────────────────────────────────────────────────────────────────────────────
      The gateway is the STRONGEST case in the stack. Its routes are lb:// URIs, so LoadBalancer resolves a
      service instance on EVERY request that enters the platform — the cache is not on a background path,
      it is on the hot path for all traffic. Spring describes the default implementation as "useful for
      development and tests" and warns about it on every startup.

      Declared separately because the gateway does not inherit service-parent, which is where the other
      services pick this up.

      Version managed by the Spring Boot parent — no <version> on purpose.
    -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <!-- The WebFlux (reactive) gateway server. `spring-cloud-starter-gateway` was renamed in Spring Cloud
         2025.0.x when the gateway split into WebFlux/WebMVC/proxy-exchange flavours; the old artifact still
         resolves but logs a deprecation warning on every boot and goes away at the next major. Paired with
         the `spring.cloud.gateway.server.webflux.*` property prefix in application.yml — swap both or
         neither.

         This starter also pulls `spring-boot-properties-migrator` (compile scope, not optional). That is
         the bean that printed the rename warnings. KEEP IT: with the prefix migrated it has nothing to
         report and stays silent, but if anyone reintroduces an old `spring.cloud.gateway.*` key it will
         remap it and say so. Excluding it would make that mistake silent — the key would simply be
         ignored and the setting would not apply. A quiet warning is worth more than a quiet failure. -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
    </dependency>
    <!-- Resilience4j circuit breaker for per-route gateway resilience (slice 27 / tech-debt #14). -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-circuitbreaker-reactor-resilience4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-bootstrap</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <!-- version managed by the Spring Boot BOM (was pinned to a vulnerable 3.1.6) -->
    </dependency>
    <!-- Observability: the gateway is the trace entry point (UI -> gateway -> services); exports
         traces + logs over OTLP. Non-agent; version from opentelemetry-instrumentation-bom (root pom). -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Reactive Redis: distributed demo-quota counter (slice 19). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis-reactive</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
