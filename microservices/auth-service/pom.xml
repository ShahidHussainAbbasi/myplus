<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.myplus</groupId>
    <artifactId>myplus-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>auth-service</artifactId>

  <dependencies>
    <!--
      Spring Cloud LoadBalancer's production cache.
      ────────────────────────────────────────────────────────────────────────────────────────────────
      auth-service resolves peers through Eureka and calls them with an @LoadBalanced client, so the
      LoadBalancer instance cache is in front of real traffic. Spring calls the default implementation
      "useful for development and tests" and warns about it on every startup.

      Declared HERE rather than inherited: auth-service and api-gateway are the two runnable services
      that do NOT extend service-parent (they extend the root aggregator directly), so the shared
      declaration there does not reach them. eureka-server and config-server are left out on purpose —
      neither resolves anything through LoadBalancer.

      Version managed by the Spring Boot parent — no <version> on purpose.
    -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-notify</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-captcha</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- C3c: auth-service OWNS tenant capabilities and stamps them into the JWT, so every service reads one
         answer with no remote call on any hot path. Needs common-web too (ApiResponse / ValidationException),
         which common-settings declares as `provided`.

         common-security for the same reason, and it is the easy one to miss: common-settings declares it
         `provided` as well, so it does NOT arrive transitively either. JwtAuthFilter now uses
         AuthenticatedUser and CurrentUser directly, and without this the module fails with the misleading
         "package com.myplus.common.security does not exist" - misleading because the package built fine one
         module earlier in the same reactor; it simply was not on THIS module's classpath. -->
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!--
      OpenTelemetry API — required BECAUSE of common-security, not for tracing.

      common-security ships TenantTelemetryFilter and declares opentelemetry-api as `provided`, on the stated
      assumption that "every instrumented consumer supplies it via opentelemetry-spring-boot-starter; API calls
      are safe no-ops when no SDK is present". That assumption holds for every service-parent child, which
      inherits the starter. auth-service extends the ROOT aggregator instead, so it inherits neither the starter
      nor the API — and an absent class is not a no-op: the context died with
      ClassNotFoundException: io.opentelemetry.context.ImplicitContextKeyed.

      The API alone, deliberately, NOT the full starter: it satisfies the filter and keeps the no-op behaviour
      the library was designed around, without switching on trace export for auth-service as a side effect of a
      capabilities change. Adding the starter is a separate, deliberate decision about observability.

      Version managed by opentelemetry-instrumentation-bom in the root pom — no <version> on purpose.
    -->
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-settings</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-web</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-config</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-bootstrap</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.modelmapper</groupId>
      <artifactId>modelmapper</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.jboss.aerogear</groupId>
      <artifactId>aerogear-otp-java</artifactId>
    </dependency>
    <!-- E1: auth-service had no test source root at all. The entitlement resolver is the one place in this
         service where being wrong is silent and expensive — it decides what a paying customer may do — so it
         ships with unit coverage that runs on the ordinary `mvn test`, per the tests-on-build standard. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
