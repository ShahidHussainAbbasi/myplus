<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.myplus</groupId>
    <artifactId>myplus-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>service-parent</artifactId>
  <packaging>pom</packaging>
  <name>service-parent</name>
  <description>Parent for resource services. Inherits shared security so every current and
    future servlet service trusts gateway-authenticated requests with no per-service code.</description>

  <dependencies>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-service</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- Observability: exports traces + logs over OTLP to the collector. Non-agent (no per-JVM
         javaagent); version managed by opentelemetry-instrumentation-bom in the root pom. Config
         (endpoint, sampling, exporters) is served centrally by config-server (otel.* keys). -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
