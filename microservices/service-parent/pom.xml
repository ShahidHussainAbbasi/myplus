<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.myplus</groupId>
    <artifactId>myplus-microservices</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>
  <artifactId>service-parent</artifactId>
  <packaging>pom</packaging>
  <name>service-parent</name>
  <description>Parent for resource services. Inherits shared security so every current and
    future servlet service trusts gateway-authenticated requests with no per-service code.</description>

  <dependencies>
    <!--
      Spring Cloud LoadBalancer's production cache.
      ────────────────────────────────────────────────────────────────────────────────────────────────
      Every service here resolves its peers through Eureka and calls them with @LoadBalanced clients, so
      the LoadBalancer's instance cache sits in front of ordinary inter-service traffic. Without Caffeine
      it falls back to a default implementation Spring itself describes as "useful for development and
      tests" and warns about on every startup.

      This was already true for six services by accident: common-settings gained Caffeine in PERF-C1, and
      the services that consume it stopped warning. Declaring it here makes that deliberate and uniform,
      so a service added tomorrow does not quietly ship the development cache.

      Version managed by the Spring Boot parent — no <version> on purpose.
    -->
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>

    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-security</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <dependency>
      <groupId>com.myplus</groupId>
      <artifactId>common-service</artifactId>
      <version>1.0.0-SNAPSHOT</version>
    </dependency>
    <!-- Observability: exports traces + logs over OTLP to the collector. Non-agent (no per-JVM
         javaagent); version managed by opentelemetry-instrumentation-bom in the root pom. Config
         (endpoint, sampling, exporters) is served centrally by config-server (otel.* keys). -->
    <dependency>
      <groupId>io.opentelemetry.instrumentation</groupId>
      <artifactId>opentelemetry-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
