# MyPlus microservices — secret template. COPY to `.env.local` (git-ignored) and fill in real
# values for local dev; in prod inject these from AWS Secrets Manager / SSM (never commit real values).
# Loaded by start-all.ps1 (exported to each service JVM) and auto-read by docker-compose.
# Service application.yml files reference these as ${VAR}; unset → the dev placeholder in yml.

# --- Database (per-service MySQL) ---
# Host/port of the shared MySQL. Default to localhost:3306 if unset; set them to point every
# service at a remote/Docker DB in one place (no service yml edits needed).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme

# --- JWT signing key (auth-service + api-gateway MUST share the same value) ---
# Generate a strong key, e.g. base64 of 48 random bytes:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-strong-random-256bit-key

# --- Internal trust secret (gateway stamps it; services trust X-User-* only when it matches) ---
# Leave empty for local dev (enforcement off); set a strong shared value in prod.
INTERNAL_SECRET=

# --- Mail (notification-service sends verification/reset; education/campaign send their own) ---
# Gmail requires an app-specific password. Empty in dev = mail simply not sent.
# MAIL_USER = full Gmail address (notification-service). MAIL_USERNAME = legacy short form (edu/campaign).
MAIL_USER=youraddress@gmail.com
MAIL_USERNAME=youraddress
MAIL_PASSWORD=

# --- Public URLs for emailed links (verification / password reset) ---
# MUST be reachable from the end user's browser. Behind nginx this is your domain (nginx proxies
# /api/ -> gateway -> auth-service). Unset -> localhost defaults, fine only for a local-only stack.
# APP_BASE_URL=https://your-domain.com
# RESET_PASSWORD_URL=https://your-domain.com/user/changePassword

# --- Bootstrap seeding: LOCAL ONLY. Compose defaults BOTH to false, so a deploy is safe by default ---
# APP_SEED_DEMO=true creates the full per-module account ladder (demo./user./admin./owner.<module>@)
# plus the named team fixtures — ALL sharing APP_DEMO_PASSWORD, a value committed to this repo.
# owner.business@ carries ROLE_OWNER + SUPER_PRIVILEGE with no write cap: full control of its tenant.
# NEVER set either flag on a public host. Real customers only ever arrive via /api/auth/register.
# APP_SEED_DEMO=true
# APP_SEED_ADMIN=true
# APP_SEED_TEST_FIXTURES=true    # multi-location/multi-branch Cypress fixtures only
# APP_DEMO_PASSWORD=             # required under the 'prod' profile if you ever opt in (no default there)
# APP_ADMIN_PASSWORD=

# --- Prod-only (set in the deployment env, not needed for local dev) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com
# DDL_AUTO=validate            # 'update' on first prod boot, 'validate' once Flyway baselines exist
# RECAPTCHA_SECRET=
