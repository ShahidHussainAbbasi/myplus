			<div>
				<div id="globalError" class="alert alert-danger text-center" style="display:none">error</div>	
			</div>
			<div id="DashboardDiv" class="formDiv dashbo">
				<div class="an-head">
					<div>
						<h3 class="an-title">School Analytics</h3>
						<div class="an-sub">Business, performance &amp; operations — at a glance</div>
					</div>
					<button id="anRefresh" class="an-btn" type="button"><span class="glyphicon glyphicon-refresh"></span> <span>Refresh</span></button>
				</div>
				<div id="anError" class="an-error" style="display:none">error</div>

				<!-- KPI headlines (populated by educationDashboard.js) -->
				<div class="an-kpis" id="anKpis"></div>

				<!-- FINANCE -->
				<div class="an-section-title"><span class="dot dot-fin"></span> <span>Finance &amp; Fee Collection</span></div>
				<div class="an-grid">
					<div class="an-panel an-wide">
						<div class="an-panel-h">Monthly collection vs due — last 12 months</div>
						<div class="an-canvas-wrap"><canvas id="chFeeTrend"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Payment methods</div>
						<div class="an-canvas-wrap"><canvas id="chPayModes"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Collection by class</div>
						<div class="an-canvas-wrap"><canvas id="chCollClass"></canvas></div>
					</div>
				</div>

				<!-- STUDENTS -->
				<div class="an-section-title"><span class="dot dot-stu"></span> <span>Students &amp; Enrollment</span></div>
				<div class="an-grid">
					<div class="an-panel an-wide">
						<div class="an-panel-h">Enrollment trend — last 12 months</div>
						<div class="an-canvas-wrap"><canvas id="chEnrollTrend"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Students per class</div>
						<div class="an-canvas-wrap"><canvas id="chStudentsClass"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Gender split</div>
						<div class="an-canvas-wrap"><canvas id="chGender"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Student status</div>
						<div class="an-canvas-wrap"><canvas id="chStatus"></canvas></div>
					</div>
				</div>

				<!-- ATTENDANCE -->
				<div class="an-section-title"><span class="dot dot-att"></span> <span>Attendance &amp; Performance</span></div>
				<div class="an-grid">
					<div class="an-panel an-wide">
						<div class="an-panel-h">Attendance rate — recent days</div>
						<div class="an-canvas-wrap"><canvas id="chAttTrend"></canvas></div>
					</div>
					<div class="an-panel">
						<div class="an-panel-h">Attendance rate by class</div>
						<div class="an-canvas-wrap"><canvas id="chAttClass"></canvas></div>
					</div>
				</div>

				<!-- STAFF -->
				<div class="an-section-title"><span class="dot dot-staff"></span> <span>Staff &amp; HR</span></div>
				<div class="an-grid">
					<div class="an-panel">
						<div class="an-panel-h">Staff by designation</div>
						<div class="an-canvas-wrap"><canvas id="chStaffDesig"></canvas></div>
					</div>
				</div>
			</div>
			<!-- P4 Team & Users — same element ids as the commerce dashboard, so /js/common/team.js drives both.
			     Assigning branches here is what scopes a teacher to a campus. -->
			<div id="TeamDiv" class="formDiv" style="display:none">
				<h3 class="dash-page-title">Team &amp; Users</h3>
				<div id="teamMsg" class="alert" style="display:none"></div>
				<!-- .form-toolbar (see /css/responsive.css): wraps as a unit at every width. The plain 12-column
				     .row put the Add button in a col-sm-1 — 64px on a tablet, which clipped its label. -->
				<div class="row form-toolbar" style="margin-bottom:14px">
					<div class="col-sm-3"><input id="teamFirstName" class="form-control" placeholder="First name"/></div>
					<div class="col-sm-3"><input id="teamLastName" class="form-control" placeholder="Last name"/></div>
					<div class="col-sm-3"><input id="teamEmail" type="email" class="form-control" placeholder="Email"/></div>
					<div class="col-sm-2">
						<select id="teamRole" class="form-control">
							<option value="USER">Teacher</option>
							<!-- Only an owner may create an admin (server-enforced). -->
							<option value="ADMIN">Admin / Principal</option>
						</select>
					</div>
					<div class="col-sm-1">
						<button type="button" id="addTeamUser" class="btn btn-success" onclick="addTeamUser()">Add</button>
					</div>
				</div>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-6">
						<label style="font-weight:600;font-size:12px;color:#7a889c;margin-bottom:4px;display:block">Assign to branch(es)</label>
						<!-- Toggle-chip picker (see /js/common/team.js) — replaces a ctrl+click <select multiple>. -->
						<div id="teamStores" class="locpick"></div>
					</div>
				</div>
				<table id="tableTeam" class="table table-bordered table-striped">
					<thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Branches</th><th></th></tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<div id="OwnerDiv" class="formDiv">
				<h3 class="dash-page-title">Owner Management</h3>
				<div style="margin-bottom:8px">
					<button type="button" id="newOwner" class="btn btn-success" onclick="newEntity('Owner')">
						<span class="glyphicon glyphicon-plus-sign"></span> <span>New Owner</span>
					</button>
					<span id="bulkBarOwner" class="crud-bulkbar" style="display:none;margin-left:10px">
						<span class="label label-info"><span class="bulk-count">0</span> <span>selected</span></span>
						<button type="button" class="btn btn-danger btn-sm" onclick="confirmBulkDelete('Owner')"><span class="glyphicon glyphicon-trash"></span> <span>Delete</span></button>
						<button type="button" class="btn btn-default btn-sm" onclick="clearSelection('Owner')">Clear</button>
					</span>
				</div>
				<div id="OwnerModal" class="crud-overlay">
				  <div class="crud-box">
					<div class="crud-head">
						<h4 id="OwnerModalTitle">New Owner</h4>
						<button type="button" class="crud-x" onclick="resetForm();closeModal('OwnerModal')">&times;</button>
					</div>
					<div class="crud-body">
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="Owner" autocomplete="off">
					<div class="form-group" style="display: none">				
						<div class="col-sm-12">
							<input type="text" class="form-control" id="ownerId" name="id"> 
						</div>
					</div>
					<div class="form-group">				
						<label class="control-label col-sm-2 req" for="ownerName">Owner name</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="ownerName" name="name"
								placeholder="Owner Name" required="required"> 
						</div>
						<label class="control-label col-sm-2 req" for="ownerMobile">Mobile</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="ownerMobile" name="mobile"
								placeholder="Mobile Number" required="required"> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req" for="ownerAddress">Address</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="ownerAddress"
								name="address" placeholder="Complete Address" required="required">
						</div>
						<label class="control-label col-sm-2" for="ownerEmail">Email</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="ownerEmail" name="email"
								placeholder="Email address">
						</div>
					</div>
					<div class="form-group">
	 					<label class="control-label col-sm-2 req" for="ownerStatus">Select Status</label>
						<div class="col-sm-4">
							<select class="form-control" id="ownerStatus" name="status" required="required">
								<option class="dropdown-item" value="Active" selected="selected">Active</option>
			 					<option class="dropdown-item" value="Inactive">Inactive</option>
			 				</select>
						</div>
					</div>
					<div class="form-group text-center">
						<button type="button" id="addOwner" class="btn btn-success">
							<span class="glyphicon glyphicon-plus-sign"></span> <span>Submit</span>
						</button>
						<button type="button" id="resetOwner" class="btn btn-warning" onclick="resetForm();closeModal('OwnerModal')">
							<span class="glyphicon glyphicon-refresh"></span> <span>Cancel</span>
						</button>
						<button type="button" id="deleteOwner" class="btn btn-danger" style="display:none"></button>
						<button type="reset" class="resetForm" style="display:none"></button>
					</div>
				</form>
					</div>
				  </div>
				</div>
				<table id="tableOwner" class="table table-striped">
					<thead>
						<tr>
							<th data-field="ownerId">Id</th>
							<th data-field="checkDelete">Check</th>
							<th data-field="name">Name</th>
							<th data-field="mobile">Mobile</th>
							<th data-field="address">Address</th>
							<th data-field="email">Email</th>
							<th data-field="ownerStatus">Status</th>
							<th data-field="ownderDated">Dated</th>
						</tr>
					</thead>
