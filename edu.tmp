									<td class="col-sm-2"><div class=" fcDTC" id="fcdd"></div></td>
								</tr>
							</tbody>
						</table> -->
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req" for="fcf">Total payment</label>
						<div class="col-sm-4">
							<input type="number" class="form-control" id="fcfp" min="0" name="feePaid" onkeyup="getDB()"
								placeholder="Enter fee amount" required="required"> 
						</div>
						<label class="control-label col-sm-2" for="fcdb">Balance</label>
						<div class="col-sm-4">
							<input type="number" class="form-control" id="fcdb" name="dueBalance" readonly="readonly"> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2" for="fcod">Other dues</label>
						<div class="col-sm-4">
							<input type="number" class="form-control" id="fcod" min="0" name="otherDues"
								placeholder="Enter other dues"> 
						</div>
						<label class="control-label col-sm-2" for="fcodd">Description</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="fcodd" name="otherDuesDescription"
								placeholder="Dues descriptions"/> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req" for="fcp">Payer</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="fcp" name="payee"
								placeholder="Submit By" required="required"/> 
						</div>
						<label class="control-label col-sm-2 req" for="fcrb">Payee</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="fcrb" name="receivedBy"
								placeholder="Reviewed by" required="required"/> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="fcri">Received In</label>
						<div class="col-sm-4">
							<select class="form-control" id="fcri" name="receivedIn" required="required">
																<option class="dropdown-item" value="Cash">Cash</option>
								<option class="dropdown-item" value="Check">Check</option>
							</select>	
						</div>
						<div id="cnd">
							<label class="control-label col-sm-2"  for="cn">Check No</label>
							<div class="col-sm-4">
								<input type="text" class="form-control" id="fccn" name="checkNo"
									placeholder="Check number"/> 
							</div>
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2" for="fcpd">Payment date</label>
						<div class="col-sm-4">
							<input type="text" class="form-control datePicker" id="fcpd" name="pdStr"
								placeholder="Payment Date"> 
						</div>
					</div>
					<div class="form-group" style="text-align: center;margin-top: 30px;margin-bottom: 0;">
						<button type="button" id="addFc" class="btn btn-success">
							<span class="glyphicon glyphicon-plus-sign"></span> <span>Submit</span>
						</button>
						<button type="button" id="deleteFc" class="btn btn-danger">
							<span class="glyphicon glyphicon-minus-sign"></span> <span>Delete</span>
						</button>
						<button type="reset" id="resetFc" class="btn btn-warning">
							<span class="glyphicon glyphicon-refresh"></span> <span>Cancel</span>
						</button>
						<button type="reset" class="resetForm" style="display:none"></button>						
					</div>
				</form>
				<div>
					<table id="tableFc" class="table table-striped">
						<thead>
							<tr>
								<th data-field="fcId">Id</th>
								<th data-field="checkfc">Check</th>
								<th data-field="fcen">Enroll No</th>
								<th>Date</th>
								<th>Payer</th>
								<th>Payee</th>
								<th>Fee</th>
								<th>V. Fee</th>
								<th>Discount</th>
								<th data-field="fchdt">Discount Type</th>
								<th>Other payment</th>
								<th>Other desc.</th>
								<th>Due Amount</th>
								<th>paid</th>
								<th>Balance</th>
								<th>Due Day</th>
								<th data-field="fcri">Received In.</th>
								<th data-field="fccn">Check No.</th>
							</tr>
						</thead>
					</table>
				</div>
			</div>		
			<div id="FVDiv" class="formDiv">
				<h4>Fee Voucher &amp; Ledger</h4>
				<br/>
				<div class="form-inline" style="margin-bottom:14px">
					<div class="form-group">
						<label class="control-label" for="fvEnroll">Student (enroll no)</label>
						<input type="text" class="form-control" id="fvEnroll" placeholder="e.g. ENR-001" style="margin:0 8px"/>
					</div>
					<button type="button" class="btn btn-primary" onclick="loadFV()"><span class="glyphicon glyphicon-list-alt"></span> <span>Generate Voucher</span></button>
					<button type="button" class="btn btn-default" onclick="loadFL()"><span class="glyphicon glyphicon-th-list"></span> <span>Show Ledger</span></button>
				</div>
				<div id="fvVoucher" style="display:none;margin-bottom:18px"></div>
				<div id="flLedgerWrap" style="display:none">
					<h5 id="flHeader"></h5>
					<table class="table table-striped">
						<thead><tr><th>Date</th><th>Fee</th><th>Discount</th><th>Other</th><th>Due</th><th>Paid</th><th>Balance</th><th>Payee</th><th>Received By</th><th>Mode</th></tr></thead>
						<tbody id="flBody"></tbody>
					</table>
				</div>
				<!-- legacy voucher form retained (hidden) to avoid disturbing other logic -->
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="FV" autocomplete="off" style="display:none">
	 				<div class="form-group">
						<label class="control-label col-sm-2 req"  for="fvp">Period</label>
						<div class="col-sm-2">
							<select class="form-control" id="dateRangeDDFV" name="vp" required="required">
								<option class="dropdown-item" value=0 selected="selected">Current month</option>
								<option class="dropdown-item" value=1>Date Range</option>
								<option class="dropdown-item" value=2>Custom</option>
							</select>	
						</div>
						<div id="customFV" style="display: none">
							<label class="control-label col-sm-2" for="fvYearDD">Year</label>
							<div class="col-sm-2">
							<select class="form-control" id="fvYearDD" required="required">
								<option class="dropdown-item" value=2019>2019</option>
								<option class="dropdown-item" value=2020 selected="selected">2020</option>
								<option class="dropdown-item" value=2021>2021</option>
								<option class="dropdown-item" value=2022>2022</option>
							</select>	
							</div>
							<label class="control-label col-sm-2" for="fvMonthsDD">Months</label>
							<div class="col-sm-2">
							<select multiple="multiple" class="selectpicker" id="fvMonthsDD" required="required">
								<option class="dropdown-item" value=1>January</option>
								<option class="dropdown-item" value=2>February</option>
								<option class="dropdown-item" value=3>March</option>
								<option class="dropdown-item" value=4>April</option>
								<option class="dropdown-item" value=5>May</option>
								<option class="dropdown-item" value=6>June</option>
								<option class="dropdown-item" value=7>July</option>
								<option class="dropdown-item" value=8>August</option>
								<option class="dropdown-item" value=9>September</option>
								<option class="dropdown-item" value=10>October</option>
								<option class="dropdown-item" value=11>November</option>
								<option class="dropdown-item" value=12>December</option>
							</select>	
							</div>
						</div>
						<div id="dateRangeFV" style="display: none">
							<label class="control-label col-sm-2" for="fvsd">From</label>
							<div class="col-sm-2">
								<input type="text" class="form-control monthYearDatePicker" id="fvsd" name="sdStr"
									placeholder="Start Date"> 
							</div>
							<label class="control-label col-sm-2" for="fved">To</label>
							<div class="col-sm-2">
								<input type="text" class="form-control monthYearDatePicker" id="fved" name="edStr"
									placeholder="End Date"> 
							</div>
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="fIssueDate">Issue date</label>
						<div class="col-sm-2">
							<input type="text" class="form-control datePickerWithMonthName" id="fIssueDate" placeholder="Issue Date" required="required"> 
						</div>
						<label class="control-label col-sm-2 req"  for="fDueDate">Due date</label>
						<div class="col-sm-2">
							<input type="text" class="form-control datePickerWithMonthName" id="fDueDate" name="dueDate"
								placeholder="Due Date" required="required"> 
						</div>
						<label class="control-label col-sm-2 req"  for="fValidDate">Valid date</label>
						<div class="col-sm-2">
							<input type="text" class="form-control datePickerWithMonthName" id="fValidDate" name="validDate"
								placeholder="Valid Date" required="required"> 
						</div>
					</div>			
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="fvb">Voucher by</label>
						<div class="col-sm-2">
							<select class="onChangeSelect selectpicker req" id="fvb" name="vb" required="required" onchange="loadFVIBSDD(this,'fviDD')">
								<option class="dropdown-item" value='' selected="selected">Not selected</option>
								<option class="dropdown-item" value='Students'>Students</option>
								<option class="dropdown-item" value='Guardians'>Guardians</option>
								<option class="dropdown-item" value='Grades'>Classes</option>
								<option class="dropdown-item" value='Schools'>Campuses</option>
							</select>	
						</div>
						<label class="control-label col-sm-2 req" for="fvi">Please Select</label>
						<div id="fvidiv" class="col-sm-2">
							<select onchange="populateArrearsDiv('fviDD')" required="required" multiple="multiple"
								class="onChangeSelect selectpicker" id="fviDD" name="vi" data-live-search="true">
							</select>
						</div>
						<label class="control-label col-sm-2" for="incl_excl_selected">Encl/Excl Selected</label>
						<div class="col-sm-2">
							<select class="onChangeSelect selectpicker" id="incl_excl_selected" name="inclExclSelected"  onchange="populateArrearsDiv('fviDD')">
								<!-- Explicit empty value: with none, the option TEXT was submitted, so a translated
								     label would have changed the posted value. (Nothing reads this field today —
								     FeeVoucherDTO.inclExclSelected is declared but never consumed — but the two
								     sibling options are value-carrying and this one must not be the odd one out.) -->
								<option class="dropdown-item" value="" selected="selected">Default All</option>
								<option class="dropdown-item" value='include'>Include Selected</option>
								<option class="dropdown-item" value='exclude'>Exclude Selected</option>
							</select>	
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2" for="fOthers">Others</label>
						<div class="col-sm-2">
							<input type="text" class="form-control" id="fOthers"
								placeholder="Enter name"> 
						</div>
						<label class="control-label col-sm-2"  for="fCharges">Charges</label>
						<div class="col-sm-2">
							<input type="number" class="form-control" id="fCharges"
								placeholder="Enter value" required="required"> 
						</div>
					</div>			
					<div class="form-group">
						<div class="col-sm-2">
						</div>
						<div class="col-sm-8" id="arrearsDiv">
						</div>
						<div class="col-sm-2">
						</div>
					</div>
					<div class="form-group" style="text-align: center; margin-top: 25px;">
						<button type="button" id="printFV" onclick="loadFV()" class="btn btn-success">
							<span class="glyphicon glyphicon-print"></span> <span>Print Voucher</span>
						</button>
						<button type="button" id="printFL" onclick="loadFL()" class="btn btn-success">
							<span class="glyphicon glyphicon-print"></span> <span>Print Ledger</span>
						</button>
						<button type="reset" class="resetForm" style="display:none"></button>
					</div>
				</form>
			</div>		
	
			<div id="ADiv" class="formDiv">
				<h4>Attendance</h4>
				<br />
				<!-- Class-roster marking: pick a class + date, load the roster, mark, and save in one go. -->
				<div class="form-inline" style="margin-bottom:16px">
					<div class="form-group">
						<label class="control-label" for="attendanceGrade">Class</label>
						<select class="form-control" id="attendanceGrade" name="gradeId" style="margin:0 10px"></select>
					</div>
					<div class="form-group">
						<label class="control-label" for="aDate">Date</label>
						<input type="date" class="form-control" id="aDate" style="margin:0 10px"/>
					</div>
					<button type="button" class="btn btn-primary" onclick="loadClassRoster()">Load Roster</button>
				</div>
				<div id="aRosterWrap" style="display:none">
					<div style="margin-bottom:10px;overflow:hidden">
						<button type="button" class="btn btn-default btn-sm" onclick="aMarkAll('Present')">Mark all Present</button>
						<button type="button" class="btn btn-default btn-sm" onclick="aMarkAll('Absent')">Mark all Absent</button>
						<button type="button" class="btn btn-success" style="float:right" onclick="saveAttendance()">Save Attendance</button>
					</div>
					<table class="table table-striped" id="aRosterTable">
						<thead>
							<tr>
								<th>Enroll No</th><th>Student</th><th>Status</th>
								<th>Time In</th><th>Time Out</th><th>Remark</th>
							</tr>
						</thead>
						<tbody id="aRosterBody"></tbody>
					</table>
				</div>
				<div id="aRosterEmpty" class="text-muted" style="display:none">No students found for this class.</div>
			</div>
	
			<div id="FRDiv" class="formDiv">
				<h4>Fee Report</h4>
				<br/>
				<div class="form-inline" style="margin-bottom:14px">
					<div class="form-group">
						<label class="control-label" for="frScope">Scope</label>
						<select class="form-control" id="frScope" style="margin:0 8px">
							<option value="ALL" selected="selected">All</option>
							<option value="STUDENT">Student (enroll no)</option>
							<option value="GUARDIAN">Guardian (id)</option>
							<option value="CLASS">Class (id)</option>
							<option value="CAMPUS">Campus (id)</option>
						</select>
					</div>
					<div class="form-group">
						<label class="control-label" for="frId">Id</label>
						<input type="text" class="form-control" id="frId" placeholder="(when not All)" style="margin:0 8px"/>
					</div>
					<div class="form-group">
						<label class="control-label" for="frFrom">From</label>
						<input type="date" class="form-control" id="frFrom" style="margin:0 8px"/>
						<label class="control-label" for="frTo">To</label>
						<input type="date" class="form-control" id="frTo" style="margin:0 8px"/>
					</div>
					<button type="button" class="btn btn-primary" onclick="loadFR()"><span class="glyphicon glyphicon-sunglasses"></span> <span>View</span></button>
				</div>
				<table id="frTable" class="table table-striped">
					<thead><tr>
						<th>Enroll No</th><th>Student</th><th>Class</th><th>Campus</th><th>Date</th>
						<th>Payee</th><th>Received By</th><th>Fee</th><th>Discount</th><th>Other</th>
						<th>Due</th><th>Paid</th><th>Balance</th>
					</tr></thead>
					<tbody id="frBody"></tbody>
					<tfoot><tr id="frTotals"></tr></tfoot>
				</table>
				<!-- legacy report form retained (hidden) to avoid disturbing other logic -->
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="FR" autocomplete="off" style="display:none">
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="frb">Fee By</label>
						<div class="col-sm-4">
							<select class="form-control" id="frb" name="rb" required="required">
								<option class="dropdown-item" value=-1 selected="selected">All</option>
								<option class="dropdown-item" value=0>Student</option>
								<option class="dropdown-item" value=1>Guardian</option>
								<option class="dropdown-item" value=2>Class</option>
								<option class="dropdown-item" value=3>Campus</option>
							</select>	
						</div>
						<!-- id dropped: it duplicated the live voucher form's #fvidiv (line ~2023). Nothing in the
						     codebase reads it, and this legacy form is display:none — but a duplicate id makes
						     getElementById return whichever comes first, which is how the alerts bug hid. -->
						<div>
							<label class="control-label col-sm-2" for="fri">Enter Id</label>
							<div class="col-sm-4">
								<input type="text" class="form-control" id="fri" name="ri"
									placeholder="Enter Id"> 
							</div>					
						</div>					
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="frbs">Status By</label>
						<div class="col-sm-4">
							<select class="form-control" id="frbs" name="rbs" required="required">
								<option class="dropdown-item" value="" selected="selected">All</option>
								<option class="dropdown-item" value="Active">Active</option>
								<option class="dropdown-item" value="Inactive">Inactive</option>
							</select>	
						</div>
						<label class="control-label col-sm-2 req"  for="frp">Period</label>
						<div class="col-sm-4">
							<select class="form-control" id="dateRangeDDFR" name="rp" required="required">
								<option class="dropdown-item" value=0 selected="selected">Current month</option>
								<option class="dropdown-item" value=1>Custom range</option>
							</select>	
						</div>
					</div>
					<div class="form-group">
						<div id="dateRangeFR" style="display: none">
							<div class="col-sm-6">
							</div>
							<label class="control-label col-sm-2" for="frsd">Date Range</label>
							<div class="col-sm-2">
								<input type="text" class="form-control datePicker" id="frsd" name="sdStr"
									placeholder="Start Date"> 
							</div>
							<div class="col-sm-2">
								<input type="text" class="form-control datePicker" id="fred" name="edStr"
									placeholder="End Date"> 
							</div>
						</div>
					</div>
					<div class="form-group" style="text-align: center; margin-top: 25px;">
						<button type="button" id="printFR" onclick="loadFR()" class="btn btn-success">
							<span class="glyphicon glyphicon-sunglasses"></span> <span>View</span>
						</button>
					</div>
					<div class="form-group">
						<table id="tableFeeReport" class="table table-striped">
					        <thead>
					            <tr>
									<th>Campus</th>
									<th>Class</th>
									<th>Guardian</th>
									<th>Student</th>
									<th>Fee</th>
									<th>Others</th>
									<th>Desc.</th>
									<th>Discount</th>
									<th>Payer</th>
									<th>Payee</th>
									<th>Date</th>
									<th>Due</th>
									<th>Paid</th>
									<th>Balance</th>
					            </tr>
					        </thead>
							<tfoot>
					            <tr>
					                <th>Totals:</th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					                <th></th>
					            </tr>
					        </tfoot>
				  		</table>
					</div>
				</form>
			</div>		
			<div id="FeeSettingDiv" class="formDiv">
				<h4>Fee Settings</h4>
				<p class="text-muted">Controls how dues are registered at student registration and how guardians pay. Applies to this organization and can be changed anytime.</p>
				<div class="form-horizontal" style="max-width:560px">
					<div class="form-group">
						<label class="control-label col-sm-5" for="fsPaymentMode">Payment mode</label>
						<div class="col-sm-6">
							<select class="form-control" id="fsPaymentMode">
								<option value="BOTH">Both (guardian voucher or independent)</option>
								<option value="GUARDIAN_VOUCHER">Guardian voucher (consolidated)</option>
								<option value="INDEPENDENT">Independent (per student)</option>
							</select>
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-5" for="fsAutoRegister">Auto-register dues at registration</label>
						<div class="col-sm-6"><input type="checkbox" id="fsAutoRegister"/></div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-5" for="fsAging">Multi-month aging</label>
						<div class="col-sm-6"><input type="checkbox" id="fsAging"/></div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-5" for="fsDueDay">Due day of month</label>
						<div class="col-sm-6"><input type="number" min="1" max="28" class="form-control" id="fsDueDay"/></div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-5" for="fsFeeBranchScoped">Restrict fee collection to each branch</label>
						<div class="col-sm-6">
							<input type="checkbox" id="fsFeeBranchScoped"/>
							<span style="color:#7a889c;font-size:12px;margin-left:6px">Off (default): a fee can be collected at any branch. On: only the student&#39;s branch sees it.</span>
						</div>
					</div>
					<div class="form-group">
						<div class="col-sm-offset-5 col-sm-6">
							<button type="button" class="btn btn-success" onclick="saveFeeSetting()"><span class="glyphicon glyphicon-floppy-disk"></span> <span>Save Settings</span></button>
						</div>
					</div>
				</div>
			</div>

			<!-- Owner Configuration — the generic per-tenant settings screen. It renders itself from the
			     education-service catalog (/getConfig); each toggle saves immediately (/saveConfig). Adding a
			     configurable policy needs a catalog entry in the service, not a change here. -->
			<!-- Slice 0.2a: fee arrears, aged 0-30/31-60/61-90/90+ by the SHARED AgingCalculator (the same engine
			     behind POS receivables). Read-only: the numbers come from the fee ledger, never typed. -->
			<div id="FeeAgingDiv" class="formDiv">
				<h3 class="dash-page-title">Fee Arrears</h3>
				<p class="text-muted">Outstanding fees per student, grouped by how long they have been due.</p>
				<div class="table-scroll">
					<table id="tableFeeAging" class="table table-bordered table-striped">
						<thead>
							<tr>
								<th>Student</th>
								<th>0-30 days</th>
								<th>31-60 days</th>
								<th>61-90 days</th>
								<th>90+ days</th>
								<th>Total</th>
								<th></th>
							</tr>
						</thead>
						<tbody id="feeAgingBody"></tbody>
					</table>
				</div>
				<div id="feeAgingEmpty" class="text-muted" style="display:none">No outstanding fees.</div>
			</div>

			<!-- Slice 0.2a: one student's statement of account, built by the SHARED StatementBuilder. -->
			<div id="FeeStatementDiv" class="formDiv">
				<h3 class="dash-page-title">Student Statement</h3>
				<div class="form-inline" style="margin-bottom:16px">
					<div class="form-group">
						<label class="control-label" for="stmtEnrollNo">Enroll No</label>
						<input type="text" class="form-control" id="stmtEnrollNo" style="margin:0 10px"/>
					</div>
					<button type="button" class="btn btn-primary" onclick="loadFeeStatement()">
						<span class="glyphicon glyphicon-search"></span> <span>View</span>
					</button>
				</div>
				<div class="table-scroll">
					<table id="tableFeeStatement" class="table table-bordered table-striped">
						<thead>
							<tr>
								<th>Date:</th>
								<th>Reference</th>
								<th>Type</th>
								<th>Charge</th>
								<th>Payment</th>
								<th>Balance</th>
							</tr>
						</thead>
						<tbody id="feeStatementBody"></tbody>
					</table>
				</div>
				<div id="feeStatementEmpty" class="text-muted" style="display:none">No entries for this student.</div>
			</div>

			<!-- ═══ Slice 1.1 — Academic Year & Term ══════════════════════════════════════════════════
			     Structure, not daily work: the owner defines the years and terms the school actually
			     runs. There is deliberately no "how many terms" setting — creating a term IS the
			     configuration (design D2). "Current" is derived from today's date; the pin is the
			     explicit override for a school holding a term open to finish entering marks (D3). -->
			<div id="AcademicYearDiv" class="formDiv">
				<h4>Academic Year</h4>
				<p class="text-muted">Define the years and terms this school runs. Exams, marks and report cards are all recorded against a term.</p>

				<div class="alert alert-info" id="ayCurrentTerm" style="display:none"></div>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="ayName">Year name</label>
						<input type="text" class="form-control" id="ayName" placeholder="2026-27">
					</div>
					<div class="col-sm-3">
						<label for="ayStart">Start Date</label>
						<input type="text" class="form-control datePicker" id="ayStart" placeholder="Start Date">
					</div>
					<div class="col-sm-3">
						<label for="ayEnd">End date</label>
						<input type="text" class="form-control datePicker" id="ayEnd" placeholder="End date">
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" id="ayAdd" class="btn btn-success" onclick="saveAcademicYear()">Add Year</button>
					</div>
				</div>

				<hr />

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="ayTermYear">Academic Year</label>
						<select class="form-control" id="ayTermYear"></select>
					</div>
					<div class="col-sm-2">
						<label for="ayTermName">Term name</label>
						<input type="text" class="form-control" id="ayTermName" placeholder="Term 1">
					</div>
					<div class="col-sm-1">
						<label for="ayTermSeq">#</label>
						<input type="number" class="form-control" id="ayTermSeq" min="1" value="1">
					</div>
					<div class="col-sm-2">
						<label for="ayTermStart">Start Date</label>
						<input type="text" class="form-control datePicker" id="ayTermStart" placeholder="Start Date">
					</div>
					<div class="col-sm-2">
						<label for="ayTermEnd">End date</label>
						<input type="text" class="form-control datePicker" id="ayTermEnd" placeholder="End date">
					</div>
					<div class="col-sm-2" style="padding-top:24px">
						<button type="button" id="ayTermAdd" class="btn btn-success" onclick="saveTerm()">Add Term</button>
					</div>
				</div>

				<table id="tableAcademicYear" class="table table-bordered table-striped">
					<thead><tr>
						<th>Academic Year</th>
						<th>Term name</th>
						<th>Start Date</th>
						<th>End date</th>
						<th>Current</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
				<div id="ayEmpty" class="text-muted" style="display:none">No academic years defined yet.</div>
			</div>

			<!-- ═══ Slice 1.2 — Examinations ═══════════════════════════════════════════════════════════
			     Two levels: the exam is the event (term + weight), its papers are per subject (out of
			     N, on a date). The class is NOT stored on a paper — a Subject already knows its Grade,
			     so the datesheet filter derives it (design D2). Once marks exist the exam LOCKS: the
			     fields that would restate results grey out, while rescheduling stays open (D5). -->
			<div id="ExamDiv" class="formDiv">
				<h4>Examinations</h4>
				<p class="text-muted">Define an exam for a term, then add one paper per subject. Marks are entered against these papers.</p>

				<div class="alert alert-warning" id="exNoTerms" style="display:none">Create an academic year and at least one term before adding exams.</div>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="exName">Exam name</label>
						<input type="text" class="form-control" id="exName" placeholder="Mid-Term">
					</div>
					<div class="col-sm-2">
						<label for="exType">Type</label>
						<!-- D6: free text with suggestions. No exam-type table and no setting — nothing
						     in the code branches on the value. -->
						<input type="text" class="form-control" id="exType" list="exTypeList" placeholder="Mid-Term">
						<datalist id="exTypeList">
							<option value="Mid-Term"></option>
							<option value="Final"></option>
							<option value="Unit Test"></option>
							<option value="Pre-Board"></option>
							<option value="Practical"></option>
						</datalist>
					</div>
					<div class="col-sm-3">
						<label for="exTerm">Term name</label>
						<select class="form-control" id="exTerm"></select>
					</div>
					<div class="col-sm-2">
						<label for="exWeight">Weight %</label>
						<input type="number" class="form-control" id="exWeight" min="0" max="100">
					</div>
					<div class="col-sm-2" style="padding-top:24px">
						<button type="button" id="exAdd" class="btn btn-success" onclick="saveExam()">Add Exam</button>
					</div>
				</div>

				<hr />

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-2">
						<label for="exPaperExam">Exam name</label>
						<select class="form-control" id="exPaperExam"></select>
					</div>
					<div class="col-sm-2">
						<label for="exPaperSubject">Subjects</label>
						<select class="form-control" id="exPaperSubject"></select>
					</div>
					<div class="col-sm-2">
						<label for="exMaxMarks">Max marks</label>
						<input type="number" class="form-control" id="exMaxMarks" min="1" value="100">
					</div>
					<div class="col-sm-2">
						<label for="exPassMarks">Pass marks</label>
						<input type="number" class="form-control" id="exPassMarks" min="0" value="33">
					</div>
					<div class="col-sm-2">
						<label for="exPaperDate">Exam date</label>
						<input type="text" class="form-control datePicker" id="exPaperDate" placeholder="Exam date">
					</div>
					<div class="col-sm-2" style="padding-top:24px">
						<button type="button" id="exPaperAdd" class="btn btn-success" onclick="saveExamPaper()">Add Paper</button>
					</div>
				</div>

				<table id="tableExam" class="table table-bordered table-striped">
					<thead><tr>
						<th>Exam name</th>
						<th>Term name</th>
						<th>Subjects</th>
						<th>Classes</th>
						<th>Max marks</th>
						<th>Exam date</th>
						<th>Status</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
				<div id="exEmpty" class="text-muted" style="display:none">No exams defined yet.</div>
			</div>

			<!-- ═══ Slice 1.3 — Marks Entry ════════════════════════════════════════════════════════════
			     Day-to-day teacher work, so NOT sec:authorize'd to ADMIN like the exam definition is
			     (design D6) — the service enforces WRITE_PRIVILEGE + branch scope.
			     Absent is a checkbox, not a zero (D2): they are different facts, and conflating them
			     corrupts every average 1.4 computes. Valid rows save even when others fail (D3). -->
			<div id="MarksDiv" class="formDiv">
				<h4>Marks Entry</h4>
				<p class="text-muted">Choose an exam and paper, then enter marks for the class. Tick Absent for a student who did not sit the paper — that is not the same as zero.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-4">
						<label for="mkExam">Exam name</label>
						<select class="form-control" id="mkExam"></select>
					</div>
					<div class="col-sm-4">
						<label for="mkPaper">Paper</label>
						<select class="form-control" id="mkPaper"></select>
					</div>
					<div class="col-sm-4" style="padding-top:24px">
						<button type="button" id="mkLoad" class="btn btn-primary" onclick="loadMarksSheet()">Load Sheet</button>
						<button type="button" id="mkSave" class="btn btn-success" onclick="saveMarks()">Save Marks</button>
					</div>
				</div>

				<div class="alert alert-info" id="mkInfo" style="display:none"></div>
				<div class="alert alert-danger" id="mkErrors" style="display:none"></div>

				<table id="tableMarks" class="table table-bordered table-striped">
					<thead><tr>
						<th>Enroll No</th>
						<th>Name</th>
						<th>Marks obtained</th>
						<th>Absent</th>
						<th>Remarks</th>
					</tr></thead>
					<tbody></tbody>
				</table>
				<div id="mkEmpty" class="text-muted" style="display:none">No students in this class, or no paper selected.</div>
			</div>

			<!-- ═══ Slice 1.4 — Grading Scale ══════════════════════════════════════════════════════════
			     Bands are an ENTITY, not settings (design D1) — a list does not fit a scalar store. The two
			     scalar POLICIES (absence-counts-as-zero, rounding) live in Configuration with the other
			     per-org settings, so there is one place for toggles and one for the table.
			     Nothing is seeded: the preset is offered, never assumed (D2). -->
			<div id="GradingDiv" class="formDiv">
				<h4>Grading Scale</h4>
				<p class="text-muted">Define the bands this school grades by. Ranges include both ends and must cover 0–100% with no gaps or overlaps. Pass/fail comes from the pass marks set on each exam paper, not from here.</p>

				<div class="alert alert-info" id="grEmpty" style="display:none">
					<span>No grading scale yet — marks will show a percentage with no letter.</span>
					<button type="button" class="btn btn-sm btn-primary" style="margin-left:10px" onclick="applyGradingPreset()">Use a standard scale</button>
				</div>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="grName">Band name</label>
						<input type="text" class="form-control" id="grName" placeholder="A">
					</div>
					<div class="col-sm-2">
						<label for="grMin">Min %</label>
						<input type="number" class="form-control" id="grMin" min="0" max="100">
					</div>
					<div class="col-sm-2">
						<label for="grMax">Max %</label>
						<input type="number" class="form-control" id="grMax" min="0" max="100">
					</div>
					<div class="col-sm-2">
						<label for="grGpa">GPA points</label>
						<input type="number" class="form-control" id="grGpa" min="0" step="0.1">
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" id="grAdd" class="btn btn-success" onclick="saveGradeBand()">Add Band</button>
					</div>
				</div>

				<table id="tableGrading" class="table table-bordered table-striped">
					<thead><tr>
						<th>Band name</th>
						<th>Min %</th>
						<th>Max %</th>
						<th>GPA points</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<!-- Slice 1.5 — report cards. Preview is derived; Publish snapshots (design D1), so the printed
			     card never changes when the grading scale is re-banded later. -->
			<div id="ReportCardDiv" class="formDiv">
				<h4>Report Cards</h4>
				<p class="text-muted">Preview a card from live marks, then publish it. A published card is a permanent record: correcting one issues a new version and keeps the old one.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="rcTerm">Term</label>
						<select class="form-control" id="rcTerm" onchange="loadReportCardStudents()"></select>
					</div>
					<div class="col-sm-3">
						<label for="rcStudent">Student</label>
						<select class="form-control" id="rcStudent"></select>
					</div>
					<div class="col-sm-6" style="padding-top:24px">
						<button type="button" class="btn btn-primary" onclick="previewReportCard()">Preview</button>
						<button type="button" class="btn btn-success" id="rcPublish" onclick="publishReportCard()">Publish</button>
						<button type="button" class="btn btn-default" onclick="loadTranscript()">Transcript</button>
						<button type="button" class="btn btn-default" onclick="window.print()">Print</button>
					</div>
				</div>

				<div id="rcWeightWarning" class="alert alert-warning" style="display:none"></div>
				<div id="rcMsg" class="alert" style="display:none"></div>

				<div id="rcCard" style="display:none">
					<div id="rcHeader" class="rc-header"></div>
					<table id="tableReportCard" class="table table-bordered table-striped">
						<thead><tr>
							<th>Exam</th>
							<th>Subject</th>
							<th>Marks obtained</th>
							<th>Max marks</th>
							<th>Percent %</th>
							<th>Grade</th>
						</tr></thead>
						<tbody></tbody>
					</table>
					<div id="rcTotals" class="rc-totals"></div>
				</div>

				<div id="rcTranscript" style="display:none">
					<h5>Transcript</h5>
					<table id="tableTranscript" class="table table-bordered table-striped">
						<thead><tr>
							<th>Term</th>
							<th>Percent %</th>
							<th>Grade</th>
							<th>Issued</th>
							<th>Version</th>
						</tr></thead>
						<tbody></tbody>
					</table>
				</div>
			</div>

			<!-- Slice 3.1 — who may sign in to the guardian portal. The portal itself is a SEPARATE page
			     (/guardianDashboard); this screen only grants and withdraws access. -->
			<div id="PortalAccessDiv" class="formDiv">
				<h4>Guardian Portal Access</h4>
				<p class="text-muted">Invite a guardian to sign in and see their own children&#39;s results, attendance, fee dues and homework — nothing else, and no other family&#39;s. Access uses the email on the guardian record. Withdrawing access takes effect immediately; the record of it is kept.</p>

				<div class="alert alert-warning" id="paDisabled" style="display:none">
					<span>The guardian portal is currently switched off in Configuration, so nobody can sign in — invitations will not work until it is turned on.</span>
				</div>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-5">
						<label for="paGuardian">Guardian</label>
						<select class="form-control" id="paGuardian"></select>
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" class="btn btn-primary" onclick="invitePortalAccess()">Invite</button>
					</div>
				</div>

				<div id="paMsg" class="alert" style="display:none"></div>

				<table id="tablePortalAccess" class="table table-bordered table-striped">
					<thead><tr>
						<th>Guardian</th>
						<th>Email</th>
						<th>Children</th>
						<th>Status</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<!-- Slice 2.5 — behaviour log. Append-only: a correction writes a NEW note and strikes the
			     original through (D3). Positive notes are first-class, so this is not a punishment ledger. -->
			<div id="MeetingsDiv" class="formDiv">
				<h4>Parents&#39; evenings</h4>
				<p class="text-muted">Create an evening, publish each teacher&#39;s slots, then open it for booking. Families book their own slot from the guardian portal - one slot per family per teacher, and the system refuses a slot that is already taken. Closing an evening stops new bookings; it does not cancel the ones already made.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-4">
						<label for="meTitle">Title</label>
						<input type="text" class="form-control" id="meTitle">
					</div>
					<div class="col-sm-3">
						<label for="meDate">Date:</label>
						<input type="text" class="form-control datepicker" id="meDate">
					</div>
					<div class="col-sm-5">
						<label for="meNotes">Notes</label>
						<input type="text" class="form-control" id="meNotes">
					</div>
				</div>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-12">
						<button type="button" class="btn btn-primary" onclick="saveMeetingEvent()">Save</button>
						<button type="button" class="btn btn-link" onclick="clearMeetingForm()">Clear</button>
					</div>
				</div>

				<div class="table-scroll" style="margin-bottom:18px">
					<table class="table table-striped" id="tableMeetingEvents">
						<thead>
							<tr>
								<th>Title</th>
								<th>Date:</th>
								<th>Status</th>
								<th></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>

				<!-- Publishing a teacher's slots. Re-running is safe: the scheduling core refuses a duplicate
				     slot, so extending an evening adds only the new part. -->
				<h5>Publish a teacher&#39;s slots</h5>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="meStaff">Teacher</label>
						<select class="form-control" id="meStaff"></select>
					</div>
					<div class="col-sm-3">
						<label for="meFrom">From</label>
						<input type="text" class="form-control" id="meFrom" placeholder="2026-10-01T18:00:00">
					</div>
					<div class="col-sm-3">
						<label for="meTo">To</label>
						<input type="text" class="form-control" id="meTo" placeholder="2026-10-01T19:00:00">
					</div>
					<div class="col-sm-2">
						<label for="meMinutes">Minutes</label>
						<input type="number" class="form-control" id="meMinutes" value="10" min="1">
					</div>
					<div class="col-sm-1" style="padding-top:24px">
						<button type="button" class="btn btn-default" onclick="publishMeetingSlots()">Publish</button>
					</div>
				</div>
				<div id="meMsg" class="alert alert-info" style="display:none"></div>

				<div class="table-scroll">
					<table class="table table-striped" id="tableMeetingSlots">
						<thead>
							<tr>
								<th>Teacher</th>
								<th>Time</th>
								<th>Available</th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>

			<div id="NoticesDiv" class="formDiv">
				<h4>Notices</h4>
				<p class="text-muted">Write a notice, check how many families it reaches, then publish it. Publishing makes it visible in the guardian and student portals immediately and queues an email to everyone it reaches who has an address on record. A published notice cannot be edited — publish a new one instead.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-5">
						<label for="ntTitle">Title</label>
						<input type="text" class="form-control" id="ntTitle">
					</div>
					<div class="col-sm-3">
						<label for="ntAudience">Audience</label>
						<select class="form-control" id="ntAudience" onchange="noticeAudienceChanged()">
							<option value="WHOLE_SCHOOL">Whole school</option>
							<option value="GUARDIANS">Guardians only</option>
							<option value="STUDENTS">Students only</option>
							<option value="ONE_CLASS">One class</option>
						</select>
					</div>
					<div class="col-sm-2" id="ntGradeWrap" style="display:none">
						<label for="ntGrade">Class</label>
						<select class="form-control" id="ntGrade" onchange="refreshNoticeReach()"></select>
					</div>
					<div class="col-sm-2">
						<label for="ntPinned">Pin until</label>
						<input type="text" class="form-control datepicker" id="ntPinned">
					</div>
				</div>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-12">
						<label for="ntBody">Message</label>
						<textarea class="form-control" id="ntBody" rows="4"></textarea>
					</div>
				</div>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-12">
						<!-- The consequence of the act, stated BEFORE the act. Same reasoning as 3.1's
						     child count on the portal invite: "you are about to tell 412 families
						     something" is the fact the person clicking needs and cannot otherwise see. -->
						<div id="ntReach" class="alert alert-info" style="padding:8px 12px;margin-bottom:10px"></div>
						<button type="button" class="btn btn-default" onclick="saveNotice()">Save draft</button>
						<button type="button" class="btn btn-primary" onclick="publishNotice()">Publish</button>
						<button type="button" class="btn btn-link" onclick="clearNoticeForm()">Clear</button>
					</div>
				</div>

				<div class="table-scroll">
					<table class="table table-striped" id="tableNotices">
						<thead>
							<tr>
								<th>Title</th>
								<th>Audience</th>
								<th>Status</th>
								<th>Published</th>
								<th></th>
							</tr>
						</thead>
						<tbody></tbody>
					</table>
				</div>
			</div>

			<div id="BehaviourDiv" class="formDiv">
				<h4>Behaviour</h4>
				<p class="text-muted">Record what happened — good as well as concerning. A note cannot be edited or deleted once saved: correcting one writes a new note and keeps the original, because the value of the record is that it says what was reported at the time.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="bnStudent">Student</label>
						<select class="form-control" id="bnStudent" onchange="loadBehaviourNotes()"></select>
					</div>
					<div class="col-sm-2">
						<label for="bnType">Type</label>
						<select class="form-control" id="bnType"></select>
					</div>
					<div class="col-sm-2">
						<label for="bnCategory">Category</label>
						<input type="text" class="form-control" id="bnCategory" list="bnCategoryList">
						<datalist id="bnCategoryList">
							<option value="Punctuality"></option>
							<option value="Classwork"></option>
							<option value="Conduct"></option>
							<option value="Helpfulness"></option>
							<option value="Uniform"></option>
						</datalist>
					</div>
					<div class="col-sm-2">
						<label for="bnOccurred">Date</label>
						<input type="date" class="form-control" id="bnOccurred">
					</div>
					<div class="col-sm-3">
						<label for="bnAuthor">Reported by</label>
						<select class="form-control" id="bnAuthor"></select>
					</div>
				</div>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-5">
						<label for="bnDescription">What happened</label>
						<input type="text" class="form-control" id="bnDescription">
					</div>
					<div class="col-sm-4">
						<label for="bnAction">Action taken</label>
						<input type="text" class="form-control" id="bnAction">
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<label style="font-weight:normal"><input type="checkbox" id="bnGuardian"> <span>Guardian informed</span></label>
						<button type="button" class="btn btn-success" onclick="saveBehaviourNote()">Record</button>
					</div>
				</div>

				<div id="bnMsg" class="alert" style="display:none"></div>
				<div id="bnSummary" class="text-muted" style="margin-bottom:10px"></div>

				<table id="tableBehaviour" class="table table-bordered table-striped">
					<thead><tr>
						<th>Date</th>
						<th>Student</th>
						<th>Type</th>
						<th>Category</th>
						<th>What happened</th>
						<th>Reported by</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<!-- Slice 2.4 — homework. Set a task, then record what each student did. Submission rows are
			     created only when there is something to record (D2), so a blank row means "nothing yet",
			     not "did not do it". Homework deliberately does NOT feed the report card (D4). -->
			<div id="HomeworkDiv" class="formDiv">
				<h4>Homework</h4>
				<p class="text-muted">Set a task for a subject, then record what each student did. A blank row means nothing has been recorded yet — &quot;not done&quot; is something you mark deliberately. Homework grades use the school&#39;s grading scale but do not count towards report cards.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="hwSubject">Subject</label>
						<select class="form-control" id="hwSubject" onchange="loadHomework()"></select>
					</div>
					<div class="col-sm-3">
						<label for="hwTitle">Title</label>
						<input type="text" class="form-control" id="hwTitle" placeholder="Fractions ex. 4">
					</div>
					<div class="col-sm-2">
						<label for="hwDue">Due Date</label>
						<input type="date" class="form-control" id="hwDue">
					</div>
					<div class="col-sm-2">
						<label for="hwMax">Out of</label>
						<input type="number" class="form-control" id="hwMax" min="1">
					</div>
					<div class="col-sm-2" style="padding-top:24px">
						<button type="button" class="btn btn-success" onclick="saveHomework()">Set</button>
					</div>
				</div>

				<div id="hwMsg" class="alert" style="display:none"></div>

				<table id="tableHomework" class="table table-bordered table-striped">
					<thead><tr>
						<th>Title</th>
						<th>Subject</th>
						<th>Class</th>
						<th>Due Date</th>
						<th>Out of</th>
						<th>Recorded</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>

				<div id="hwSheet" style="display:none;margin-top:20px">
					<h5 id="hwSheetTitle"></h5>
					<table id="tableHomeworkSheet" class="table table-bordered table-striped">
						<thead><tr>
							<th>Enroll No</th>
							<th>Name</th>
							<th>Status</th>
							<th>Submitted</th>
							<th>Marks obtained</th>
							<th>Grade</th>
							<th>Feedback</th>
						</tr></thead>
						<tbody></tbody>
					</table>
					<button type="button" class="btn btn-success" onclick="saveHomeworkSheet()">Save sheet</button>
				</div>
			</div>

			<!-- Slice 2.3 — the staff register. Marking ABSENT or LEAVE writes 2.2's StaffAbsence, so the
			     lessons appear on the substitution screen immediately; correcting to PRESENT clears it. -->
			<div id="StaffRegisterDiv" class="formDiv">
				<h4>Staff Register</h4>
				<p class="text-muted">Mark who was in today. Anyone marked absent or on leave appears on the Substitution screen with their lessons needing cover. Lateness is worked out from each person&#39;s contracted start time plus the grace period in Configuration.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="srDate">Date:</label>
						<input type="date" class="form-control" id="srDate" onchange="loadStaffRegister()">
					</div>
					<div class="col-sm-9" style="padding-top:24px">
						<button type="button" class="btn btn-success" onclick="saveStaffRegister()">Save register</button>
						<button type="button" class="btn btn-default" onclick="markAllPresent()">All present</button>
					</div>
				</div>

				<div id="srMsg" class="alert" style="display:none"></div>
				<table id="tableStaffRegister" class="table table-bordered table-striped">
					<thead><tr>
						<th>Teacher</th>
						<th>Designation</th>
						<th>Status</th>
						<th>Time In</th>
						<th>Remarks</th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<!-- Slice 2.3 — leave. Requesting is open (a teacher asks for their own); deciding is ADMIN,
			     because an approval writes absences that pull other teachers into cover. -->
			<div id="LeaveDiv" class="formDiv">
				<h4>Leave</h4>
				<p class="text-muted">Request time off and track balances. A balance is worked out from approved requests — it is never stored, so it cannot drift. A request over the balance is still recorded; the overage is shown to whoever approves it.</p>

				<div id="lvMsg" class="alert" style="display:none"></div>

				<!-- Leave types (ADMIN) -->
				<div>
					<h5>Leave types</h5>
					<div class="row" style="margin-bottom:14px">
						<div class="col-sm-3">
							<label for="ltName">Type</label>
							<input type="text" class="form-control" id="ltName" placeholder="Casual">
						</div>
						<div class="col-sm-2">
							<label for="ltQuota">Days per year</label>
							<input type="number" class="form-control" id="ltQuota" min="0">
						</div>
						<div class="col-sm-3" style="padding-top:24px">
							<label style="font-weight:normal"><input type="checkbox" id="ltPaid" checked> <span>Paid</span></label>
							<button type="button" class="btn btn-success" onclick="saveLeaveType()">Add type</button>
						</div>
					</div>
					<table id="tableLeaveTypes" class="table table-bordered table-striped">
						<thead><tr>
							<th>Type</th>
							<th>Days per year</th>
							<th>Paid</th>
							<th></th>
						</tr></thead>
						<tbody></tbody>
					</table>
				</div>

				<!-- Request -->
				<h5 style="margin-top:20px">Request leave</h5>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="lrStaff">Teacher</label>
						<select class="form-control" id="lrStaff" onchange="loadLeaveBalances()"></select>
					</div>
					<div class="col-sm-2">
						<label for="lrType">Type</label>
						<select class="form-control" id="lrType"></select>
					</div>
					<div class="col-sm-2">
						<label for="lrFrom">From</label>
						<input type="date" class="form-control" id="lrFrom">
					</div>
					<div class="col-sm-2">
						<label for="lrTo">To</label>
						<input type="date" class="form-control" id="lrTo">
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" class="btn btn-primary" onclick="saveLeaveRequest()">Submit</button>
					</div>
				</div>

				<h5>Balances</h5>
				<table id="tableLeaveBalances" class="table table-bordered table-striped">
					<thead><tr>
						<th>Type</th>
						<th>Days per year</th>
						<th>Taken</th>
						<th>Remaining</th>
					</tr></thead>
					<tbody></tbody>
				</table>

				<h5 style="margin-top:20px">Requests</h5>
				<table id="tableLeaveRequests" class="table table-bordered table-striped">
					<thead><tr>
						<th>Teacher</th>
						<th>Type</th>
						<th>From</th>
						<th>To</th>
						<th>Days</th>
						<th>Status</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<!-- Slice 2.2 — substitution. The morning screen: who is out, and who covers their lessons.
			     Read-open (a teacher must see they are covering period 3); every WRITE is ADMIN, enforced
			     server-side regardless of what renders here. -->
			<div id="SubstitutionDiv" class="formDiv">
				<h4>Substitution</h4>
				<p class="text-muted">Mark who is out today, then cover their lessons. A teacher already teaching, absent, or covering elsewhere in the same period is not offered. Lessons with nobody assigned stay visible until they are covered.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="sbDate">Date:</label>
						<input type="date" class="form-control" id="sbDate" onchange="loadSubstitutionDay()">
					</div>
					<div class="col-sm-3">
						<label for="sbTerm">Term</label>
						<select class="form-control" id="sbTerm" onchange="loadSubstitutionDay()"></select>
					</div>
					<div class="col-sm-4">
						<label for="sbAbsentStaff">Mark absent</label>
						<select class="form-control" id="sbAbsentStaff"></select>
					</div>
					<div class="col-sm-2" style="padding-top:24px">
						<button type="button" class="btn btn-warning" onclick="markStaffAbsent()">Mark absent</button>
					</div>
				</div>

				<div id="sbUncovered" class="alert alert-danger" style="display:none"></div>
				<div id="sbMsg" class="alert" style="display:none"></div>

				<h5>Out today</h5>
				<table id="tableAbsences" class="table table-bordered table-striped">
					<thead><tr>
						<th>Teacher</th>
						<th>Reason</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>

				<h5 style="margin-top:20px">Lessons needing cover</h5>
				<table id="tableSubstitution" class="table table-bordered table-striped">
					<thead><tr>
						<th>Period</th>
						<th>Class</th>
						<th>Subject</th>
						<th>Absent</th>
						<th>Cover</th>
					</tr></thead>
					<tbody></tbody>
				</table>

				<button type="button" class="btn btn-default" style="margin-top:10px" onclick="window.print()">Print</button>
			</div>

			<!-- Slice 2.1 — timetable. Everyone may READ it; the editing controls are ADMIN-gated below and
			     the server enforces the same tier regardless of what renders here. -->
			<div id="TimetableDiv" class="formDiv">
				<h4>Timetable</h4>
				<p class="text-muted">Define the school day once as periods, then place a subject and teacher in each slot. A teacher or a class can only be in one place at a time — the system refuses those. A shared room is only a warning.</p>

				<div class="alert alert-info" id="ttNoPeriods" style="display:none">
					<span>No periods defined yet — set up the school day below before building a timetable.</span>
				</div>

				<!-- The school day (ADMIN only) -->
				<div>
					<h5>The school day</h5>
					<div class="row" style="margin-bottom:14px">
						<div class="col-sm-3">
							<label for="pdName">Period name</label>
							<input type="text" class="form-control" id="pdName" placeholder="Period 1">
						</div>
						<div class="col-sm-2">
							<label for="pdSeq">Order</label>
							<input type="number" class="form-control" id="pdSeq" min="0">
						</div>
						<div class="col-sm-2">
							<label for="pdStart">Start</label>
							<input type="time" class="form-control" id="pdStart">
						</div>
						<div class="col-sm-2">
							<label for="pdEnd">End</label>
							<input type="time" class="form-control" id="pdEnd">
						</div>
						<div class="col-sm-3" style="padding-top:24px">
							<label style="font-weight:normal"><input type="checkbox" id="pdTeaching" checked> <span>Teaching</span></label>
							<button type="button" class="btn btn-success" onclick="savePeriod()">Add Period</button>
						</div>
					</div>
					<table id="tablePeriods" class="table table-bordered table-striped">
						<thead><tr>
							<th>Period name</th>
							<th>Order</th>
							<th>Start</th>
							<th>End</th>
							<th>Teaching</th>
							<th></th>
						</tr></thead>
						<tbody></tbody>
					</table>
				</div>

				<!-- The grid -->
				<h5 style="margin-top:20px">Timetable</h5>
				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="ttTerm">Term</label>
						<select class="form-control" id="ttTerm" onchange="loadTimetable()"></select>
					</div>
					<div class="col-sm-3">
						<label for="ttGrade">Class</label>
						<select class="form-control" id="ttGrade" onchange="loadTimetable()"></select>
					</div>
					<div class="col-sm-3">
						<label for="ttStaffView">Teacher view</label>
						<select class="form-control" id="ttStaffView" onchange="loadTimetableByTeacher()"></select>
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" class="btn btn-default" onclick="copyTimetable()">Copy to term…</button>
						<button type="button" class="btn btn-default" onclick="window.print()">Print</button>
					</div>
				</div>

				<div id="ttMsg" class="alert" style="display:none"></div>
				<table id="tableTimetable" class="table table-bordered"><thead></thead><tbody></tbody></table>

				<!-- Slot editor (ADMIN only) -->
				<div id="ttEditor" style="display:none;margin-top:14px">
					<h5>Schedule a lesson</h5>
					<div class="row">
						<div class="col-sm-2">
							<label for="ttDay">Day</label>
							<select class="form-control" id="ttDay"></select>
						</div>
						<div class="col-sm-2">
							<label for="ttPeriod">Period</label>
							<select class="form-control" id="ttPeriod"></select>
						</div>
						<div class="col-sm-3">
							<label for="ttSubject">Subject</label>
							<select class="form-control" id="ttSubject"></select>
						</div>
						<div class="col-sm-3">
							<label for="ttStaff">Teacher</label>
							<select class="form-control" id="ttStaff"></select>
						</div>
						<div class="col-sm-2">
							<label for="ttRoom">Room</label>
							<input type="text" class="form-control" id="ttRoom">
						</div>
					</div>
					<button type="button" class="btn btn-success" style="margin-top:10px" onclick="saveTimetableEntry()">Save lesson</button>
				</div>
			</div>

			<!-- Slice 1.6 — promotion. Plan first, apply second (design D1/D7): this rewrites the class of
			     every child in a roster, so nothing here runs without a reviewed plan on screen. -->
			<div id="PromotionDiv" class="formDiv">
				<h4>Promotion</h4>
				<p class="text-muted">Move a class forward at year end. Choose the class students are leaving and the class they are joining, review the proposal for each student, then apply. Leave the target class empty for the final class — those students graduate.</p>

				<div class="row" style="margin-bottom:14px">
					<div class="col-sm-3">
						<label for="prYear">Academic Year</label>
						<select class="form-control" id="prYear"></select>
					</div>
					<div class="col-sm-3">
						<label for="prFromGrade">From class</label>
						<select class="form-control" id="prFromGrade"></select>
					</div>
					<div class="col-sm-3">
						<label for="prToGrade">To class</label>
						<select class="form-control" id="prToGrade"></select>
					</div>
					<div class="col-sm-3" style="padding-top:24px">
						<button type="button" class="btn btn-primary" onclick="loadPromotionPlan()">Plan</button>
						<button type="button" class="btn btn-danger" id="prRun" onclick="runPromotion()" disabled>Apply</button>
					</div>
				</div>

				<div id="prSummary" class="alert alert-info" style="display:none"></div>
				<div id="prMsg" class="alert" style="display:none"></div>

				<table id="tablePromotion" class="table table-bordered table-striped">
					<thead><tr>
						<th>Enroll No</th>
						<th>Name</th>
						<th>Year average</th>
						<th>Decision</th>
						<th>Reason</th>
					</tr></thead>
					<tbody></tbody>
				</table>

				<h5 style="margin-top:24px">Promotion history</h5>
				<table id="tablePromotionHistory" class="table table-bordered table-striped">
					<thead><tr>
						<th>Student</th>
						<th>From class</th>
						<th>To class</th>
						<th>Decision</th>
						<th>Reason</th>
						<th></th>
					</tr></thead>
					<tbody></tbody>
				</table>
			</div>

			<div id="ConfigDiv" class="formDiv">
				<h4>Configuration</h4>
				<p style="color:#7a889c">Owner setup. Changes apply to this organization only and take effect immediately.</p>
				<div id="configMsg" class="alert" style="display:none"></div>
				<div id="configBody">Loading…</div>
			</div>
			<form action="/impStudents" method="post" enctype="multipart/form-data" style="display: none"><input type="hidden" name="_csrf" value="5d63c723-6f2f-495e-9844-599d34080b64"/>
			    <input type="file" name="file">

				<input type="submit" value="Import" />
			</form>
		</div>
	    <!-- The bulk-delete confirmation is no longer page markup: confirmBulkDelete() raises the shared app
	         dialog (/js/common/confirm-dialog.js), so every destructive confirm looks the same. -->
	    <!-- Contact-360 (a student's roles across modules) is sensitive → owner/admin only; server enforces too. -->
	    <script>window.canViewContact360 = true;</script>
	    
