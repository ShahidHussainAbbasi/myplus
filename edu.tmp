                <ul class="nav navbar-nav navbar-right">
                    <li style="display:flex;align-items:center;padding:9px 4px">
                        
  <div class="lang-switch">
    <button type="button" class="lang-switch__btn" onclick="langSwitchToggle(event)"
            title="Choose language" aria-haspopup="true" aria-expanded="false">
      <span class="glyphicon glyphicon-globe" aria-hidden="true"></span>
      <span class="lang-switch__current">English</span>
      <span class="lang-switch__caret glyphicon glyphicon-chevron-down" aria-hidden="true"></span>
    </button>
    <ul class="lang-switch__menu" role="menu">
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=en"
           lang="en"
           dir="ltr"
           class="is-active">English</a>
      </li>
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=fr"
           lang="fr"
           dir="ltr">Français</a>
      </li>
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=es"
           lang="es"
           dir="ltr">Español</a>
      </li>
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=hi"
           lang="hi"
           dir="ltr">हिन्दी</a>
      </li>
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=ar"
           lang="ar"
           dir="rtl">العربية</a>
      </li>
      <li>
        <!-- A bare "?lang=xx" is a relative reference: the browser keeps the current path and
             replaces only the query, so the visitor stays on the page they were reading. -->
        <a role="menuitem"
           href="?lang=ur"
           lang="ur"
           dir="rtl">اردو</a>
      </li>
    </ul>
  </div>

                    </li>
                    <!-- Logged-in user info + logout -->
                    <li style="display:flex;align-items:center;gap:10px;padding:5px 4px">
                        <span style="display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.12);border-radius:100px;padding:3px 12px 3px 4px;color:#fff">
                            <span style="width:26px;height:26px;border-radius:50%;background:#1565C0;display:inline-flex;align-items:center;justify-content:center;color:#fff;flex-shrink:0">
                                <span class="glyphicon glyphicon-user" style="font-size:12px"></span>
                            </span>
                            <span style="display:flex;flex-direction:column;line-height:1.15">
                                <span style="font-weight:600;font-size:12.5px">Owner Education</span>
                                <span style="opacity:.72;font-size:10.5px">owner.education@myplus.com</span>
                            </span>
                        </span>
                        <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"
                           style="display:inline-flex;align-items:center;gap:6px;background:#e23b4e;color:#fff;border-radius:8px;padding:6px 14px;font-weight:600;font-size:12.5px;text-decoration:none;box-shadow:0 2px 8px rgba(226,59,78,.35)">
                            <span class="glyphicon glyphicon-log-out"></span> <span>Logout</span>
                        </a>
                        <form style="display:none" id="logoutForm"
                              method="post" action="/logout"><input type="hidden" name="_csrf" value="5d63c723-6f2f-495e-9844-599d34080b64"/></form>
                    </li>
                    
                </ul>
