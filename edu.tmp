<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<link rel="icon" type="image/png" href="/favicon.png"/>
<title>Education Dashboard — MyPlus</title>

        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="preconnect" href="https://fonts.googleapis.com"/>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet"/>
        <!-- Script webfont for languages Inter does not cover (Arabic, Urdu, Devanagari). Without it
             the UI falls back to whatever the OS has — often a mismatched serif, sometimes boxes.
             Each language declares its OWN font (SupportedLanguage.getWebfont), so exactly one family
             is fetched and Latin-script visitors download nothing extra. Keyed on the font rather than
             on direction because Hindi is left-to-right but still needs one. -->
        
        <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
        <link rel="stylesheet" href="/bootstrap/css/bootstrap-datepicker.min.css">
        <link rel="stylesheet" href="/bootstrap/css/bootstrap-select.min.css"/>
        <link rel="stylesheet" href="/css/jquery.dataTables.min.css">
        <link rel="stylesheet" href="/css/buttons.dataTables.min.css">
        <link rel="stylesheet" href="/css/application.css"/>
        <link rel="stylesheet" href="/main.css"/>
        <link rel="stylesheet" href="/css/theme.css"/>
        <link rel="stylesheet" href="/css/crud-modal.css"/>
        <link rel="stylesheet" href="/css/team-picker.css"/>
        <link rel="stylesheet" href="/css/jquery.timepicker.min.css"/>
        <!-- The app's own date/datetime calendar (see /js/common/date-picker.js) — no third-party picker. -->
        <link rel="stylesheet" href="/css/date-picker.css"/>
        <!-- The one responsive contract (767/991/1199) for every dashboard. Loaded LAST so it settles
             disagreements between theme.css, sidebar.css and crud-modal.css instead of adding a fourth. -->
        <link rel="stylesheet" href="/css/responsive.css"/>
        <link rel="stylesheet" href="/css/lang-switcher.css"/>
        <!-- RTL corrections for Arabic/Urdu. After responsive.css so it wins, and only for RTL
             locales so an LTR page neither downloads nor evaluates it. -->
        
        <!-- Slice 1.5: paper rules for every screen (report cards are the first real consumer). Last, and
             media-scoped, so it can only ever affect printing. -->
        <link rel="stylesheet" media="print" href="/css/print.css"/>
    
<link rel="stylesheet" href="/css/dashboard.css"/>
<link rel="stylesheet" href="/css/sidebar.css"/>
<style>
/* ===== Owner analytics dashboard (slice 22) ===== */
#DashboardDiv.dashbo{padding:18px 20px}
.an-head{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px}
.an-title{margin:0;font-weight:800;font-size:22px;color:#0D2353}
.an-sub{font-size:13px;color:#64748b;margin-top:2px}
.an-btn{border:1px solid #cbd5e1;background:#fff;border-radius:8px;padding:7px 14px;font-size:13px;font-weight:600;color:#334155;cursor:pointer}
.an-btn:hover{border-color:#1565C0;color:#1565C0}
.an-error{background:#fee2e2;border:1px solid #fecaca;color:#b91c1c;border-radius:8px;padding:10px 14px;margin-bottom:12px;font-size:13px}
.an-kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;margin-bottom:4px}
.an-kpi{background:#fff;border:1px solid #e8edf5;border-radius:12px;padding:14px 16px;box-shadow:0 1px 3px rgba(13,35,83,.05)}
.an-kpi-l{font-size:11.5px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:#64748b;display:flex;align-items:center;gap:7px}
.an-kpi-l .glyphicon{font-size:13px;top:1px}
.an-kpi-v{font-size:26px;font-weight:800;color:#0D2353;margin-top:6px;line-height:1.1}
.an-kpi-sub{font-size:12px;color:#64748b;margin-top:4px}
.an-kpi-sub .up{color:#15803d;font-weight:700}.an-kpi-sub .down{color:#b91c1c;font-weight:700}
.an-kpi.accent-fin{border-top:3px solid #1565C0}.an-kpi.accent-stu{border-top:3px solid #7C3AED}
.an-kpi.accent-att{border-top:3px solid #0E7490}.an-kpi.accent-staff{border-top:3px solid #B45309}
.an-section-title{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:800;color:#0D2353;margin:24px 0 12px}
.an-section-title .dot{width:10px;height:10px;border-radius:50%}
.dot-fin{background:#1565C0}.dot-stu{background:#7C3AED}.dot-att{background:#0E7490}.dot-staff{background:#B45309}
.an-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:14px}
.an-panel{background:#fff;border:1px solid #e8edf5;border-radius:12px;padding:14px 16px;box-shadow:0 1px 3px rgba(13,35,83,.05);min-width:0}
.an-panel.an-wide{grid-column:span 2}
/* 767px = the app's phone edge (see /css/responsive.css); 780 was an odd edge of its own. */
@media(max-width:767px){.an-panel.an-wide{grid-column:span 1}}
.an-panel-h{font-size:13px;font-weight:700;color:#334155;margin-bottom:10px}
.an-canvas-wrap{position:relative;height:260px}
.an-empty{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-size:13px}
</style>
</head>
<body class="has-sidebar">
<button type="button" id="sidebar-mobile-btn" onclick="openSidebar()" aria-label="Open menu"><span class="glyphicon glyphicon-menu-hamburger"></span></button>
<div class="sidebar-backdrop" onclick="closeSidebar()"></div>
