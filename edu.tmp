			<div id="StudentDiv" class="formDiv">
				<h3 class="dash-page-title">Student Management</h3>
				<!-- Bulk CSV import (slice 15): download a template, upload a filled CSV, see a summary. -->
				<div class="panel panel-default">
					<div class="panel-heading"><b>Import Students (CSV)</b></div>
					<div class="panel-body form-inline">
						<button type="button" class="btn btn-link" onclick="downloadStudentTemplate()">
							<span class="glyphicon glyphicon-download-alt"></span> <span>Download template</span>
						</button>
						<input type="file" id="impStudentsFile" accept=".csv" class="form-control" style="display:inline-block;width:auto;margin:0 8px"/>
						<button type="button" class="btn btn-primary" onclick="importStudents()">
							<span class="glyphicon glyphicon-upload"></span> <span>Import</span>
						</button>
						<span class="text-muted" style="margin-left:8px">Columns: enrollNo, name, gradeName, gender, guardianName, mobile, status</span>
						<div id="impStudentsSummary" style="margin-top:12px"></div>
					</div>
				</div>
				<br />
				<div style="margin-bottom:8px">
					<button type="button" id="newStudent" class="btn btn-success" onclick="newEntity('Student')">
						<span class="glyphicon glyphicon-plus-sign"></span> <span>New Student</span>
					</button>
					<span id="bulkBarStudent" class="crud-bulkbar" style="display:none;margin-left:10px">
						<span class="label label-info"><span class="bulk-count">0</span> <span>selected</span></span>
						<button type="button" class="btn btn-danger btn-sm" onclick="confirmBulkDelete('Student')"><span class="glyphicon glyphicon-trash"></span> <span>Delete</span></button>
						<button type="button" class="btn btn-default btn-sm" onclick="clearSelection('Student')">Clear</button>
					</span>
				</div>
				<div id="StudentModal" class="crud-overlay">
