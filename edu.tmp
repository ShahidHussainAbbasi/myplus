				<h4>Public Alerts</h4>
				<form action="/educationDashboard.html" method="POST" class="form-horizontal" role="form" enctype="multipart/form-data" id="PAForm" autocomplete="off">
				<!-- <form method="POST" enctype="multipart/form-data" id="maForm"> -->
				<!-- <form th:action="@{/importCSV}" method="post" id="maForm" enctype="multipart/form-data"> -->
					<div class="" style="padding-bottom: 15px;padding-top: 10px;">
				    	<input type="file" name="file" id="csvFile" accept=".csv" class="btn btn-primary" style="float: left" title="Choose CSV file">
						<input type="button" id="paBtn" value="Import" onclick="return paImportContacts()" class="btn btn-success" style="margin-left: 10px;">
					</div>
				</form>
				<table id="tablePA" class="table table-striped">
			        <thead>
			            <tr>
			            	<th>Id</th>
							<th>Dated</th>
							<th>Channel</th>
							<th>Target</th>
							<th>Status</th>
			            </tr>
			        </thead>
	   		    </table>
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="PA" autocomplete="off">
					<div class="" style="padding-bottom: 15px;padding-top: 10px;">
						<input type="text" class="form-control" style="margin-bottom: 5px" id="pah" name="pah"
							placeholder="Heading" title="Subject" required="required">
						<textarea class="form-control" style="margin-bottom: 5px" rows="5" id="pam" name="pam" title="Message details" placeholder="Message details ..." required="required"></textarea> 
						<input type="text" class="form-control" style="margin-bottom: 10px" id="pas" name="pas" title="Signature" placeholder="Signature">
					</div>
					<div class="form-group">
						<input type="checkbox" name="isEmail" id="email" class="btn default">
							<span class="glyphicon glyphicon-envelope"></span> <span>Email</span>
						</input>
						<input type="checkbox" name="isMobile" id="mobile" class="btn default">
							<span class="glyphicon glyphicon-phone"></span> <span>Mobile</span>
						</input>
						<input type="checkbox" name="isAll" id="all" checked="checked" class="btn default" >
							<span class="glyphicon glyphicon-random"></span> <span>All</span>
						</input>
						<button type="button" id="sendPA" class="btn btn-success">
							<span class="glyphicon glyphicon-send"></span> <span>Send</span>
						</button>
					</div>
				</form>   		    
			</div>				
			<div id="AlertsDiv" class="formDiv">
				<h4>Alerts Management</h4>
				<br />
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="Alerts" autocomplete="off">
					<div class="form-group" style="display: none">				
						<div class="col-sm-6">
							<input type="text" class="form-control" id="alertId" name="id"> 
						</div>
						<div class="col-sm-6">
						</div>
					</div>				
					<div class="form-group">		
						<label class="control-label col-sm-2 req" for="alertConsumers">Select Consumers</label>
						<div class="col-sm-4">
							<select multiple="multiple"	class="form-control selectpicker" id="alertConsumers" name="c" required="required" title="Select consumers…" data-live-search="true" data-actions-box="true" data-selected-text-format="count &gt; 2" data-width="100%">
																<option class="dropdown-item" value="Students">Students</option>
			 					<option class="dropdown-item" value="Guardians">Guardians</option>
								<option class="dropdown-item" value="Employees">Employees</option>
			 					<option class="dropdown-item" value="Drivers">Drivers</option>
								<option class="dropdown-item" value="Public">Public</option>
								<option class="dropdown-item" value="All">All</option>
			 				</select>
						</div>
						<label class="control-label col-sm-2 req" for="alertType">Alert Type</label>
						<div class="col-sm-4">
							<select multiple="multiple"	class="form-control selectpicker" id="alertType" name="at" required="required" title="Select alert type…" data-live-search="true" data-actions-box="true" data-selected-text-format="count &gt; 2" data-width="100%">
																<option class="dropdown-item" value="Notice Board">Notice Board</option>
			 					<option class="dropdown-item" value="Late Fee">Late Fee</option>
								<option class="dropdown-item" value="Fee Reviwed">Fee Reviewed</option>
			 					<option class="dropdown-item" value="Timing Issue">Timing Issue</option>
								<option class="dropdown-item" value="Performace">Performance</option>
								<option class="dropdown-item" value="Policies Reviwed">Policies Reviewed</option>
								<option class="dropdown-item" value="Ethics">Ethics</option>
								<option class="dropdown-item" value="Promotions">Promotions</option>
								<option class="dropdown-item" value="Holidays">Holidays</option>
								<option class="dropdown-item" value="Vacations">Vacations</option>
								<option class="dropdown-item" value="Attendance">Attendance</option>
			 				</select>
						</div>
					</div>
					<div class="form-group">		
						<label class="control-label col-sm-2 req" for="alertDeliveryChannel">Delivery Channel</label>
						<div class="col-sm-4">
							<select multiple="multiple"	class="form-control selectpicker" id="alertDeliveryChannel" name="dc" required="required" title="Select channels…" data-live-search="true" data-actions-box="true" data-selected-text-format="count &gt; 2" data-width="100%">
											 					<option class="dropdown-item" value="Email">Email</option>
								<option class="dropdown-item" value="SMS">SMS</option>
								<option class="dropdown-item" value="Watts App">Watts App</option>
			 					<option class="dropdown-item" value="Facebook">Facebook</option>
								<option class="dropdown-item" value="Twitter">Twitter</option>
			 					<option class="dropdown-item" value="Instagram">Instagram</option>
			 				</select>
						</div>
						<label class="control-label col-sm-2 req" for="alertDeliveryPeriod">Delivery Channel</label>
						<div class="col-sm-4">
							<select multiple="multiple"	class="form-control selectpicker" id="alertDeliveryPeriod" name="dp" required="required" title="Select frequency…" data-live-search="true" data-actions-box="true" data-selected-text-format="count &gt; 2" data-width="100%">
																<option class="dropdown-item" value="Daily">Daily</option>
			 					<option class="dropdown-item" value="Weekly">Weekly</option>
								<option class="dropdown-item" value="Monthly">Monthly</option>
			 					<option class="dropdown-item" value="Quartly">Quarterly</option>
								<option class="dropdown-item" value="Yearly">Yearly</option>
								<option class="dropdown-item" value="Random">Random</option>
			 				</select>
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req" for="alertDeliveryType">Delivery Type</label>
						<div class="col-sm-4">
							<select	class="form-control" id="alertDeliveryType" name="dt" required="required">
																<option class="dropdown-item" value="Manual">Manual</option>
			 					<option class="dropdown-item" value="Auto">Auto</option>
			 				</select>
						</div>
	 					<label class="control-label col-sm-2 req" for="alertStatus">Select Status</label>
						<div class="col-sm-4">
							<select class="form-control" id="alertStatus" name="st" required="required">
								<option class="dropdown-item" value="Active" selected="selected">Active</option>
			 					<option class="dropdown-item" value="Inactive">Inactive</option>
			 				</select>
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2" for="alertStartDate">Start Date</label>
						<div class="col-sm-4">
							<input type="text" class="form-control datePicker" id="alertStartDate" name="sdStr"
								placeholder="Start Date"> 
						</div>
						<label class="control-label col-sm-2" for="alertEndDate">End Date</label>
						<div class="col-sm-4">
							<input type="text" class="form-control datePicker" id="alertEndDate" name="edStr"
								placeholder="End Date"> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="alertHeading">Heading</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="alertHeading" name="ah"
								placeholder="Message heading" required="required"> 
						</div>
						<div class="col-sm-6">
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2 req"  for="alertMessage">Details</label>
						<div class="col-sm-10">
							<textarea class="form-control" rows="5" id="alertMessage" name="am" placeholder="Enter message detail here..." required="required"></textarea> 
						</div>
					</div>
					<div class="form-group">
						<label class="control-label col-sm-2"  for="alertSignature">Signature</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="alertSignature" name="as"
								placeholder="Message signature"> 
						</div>
					</div>
					<div class="form-group" style="text-align: center">
						<button type="button" id="addAlerts" class="btn btn-success">
							<span class="glyphicon glyphicon-plus-sign"></span> <span>Submit</span>
						</button>
						<button type="button" id="deleteAlerts" class="btn btn-danger">
							<span class="glyphicon glyphicon-minus-sign"></span> <span>Delete</span>
						</button>
						<button type="reset" id="resetAlerts" class="btn btn-warning">
							<span class="glyphicon glyphicon-refresh"></span> <span>Cancel</span>
						</button>
						<button type="reset" id="sendAlerts" class="btn btn-primary">
							<span class="glyphicon glyphicon-send"></span> <span>Send</span>
						</button>
						<button type="reset" class="resetForm" style="display:none"></button>						
					</div>
				</form>
				<div>
					<table id="tableAlerts" class="table table-striped">
						<thead>
							<tr>
								<th data-field="alertId">Id</th>
								<th data-field="checkAlerts">Check</th>
								<th data-field="acdd">Consumer</th>
								<th data-field="atdd">Type</th>
								<th data-field="adcdd">Del. Channel</th>
								<th data-field="adpdd">Del. Period</th>
								<th data-field="adtdd">Del. Type</th>
								<th data-field="ast">Status</th>
								<th data-field="asd">Start Date</th>
								<th data-field="aed">End Date</th>
								<th data-field="ah">Heading</th>
								<th data-field="am">Message</th>
								<th data-field="as">Signature</th>
							</tr>
						</thead>
					</table>
				</div>
			</div>		
				
			<div id="FcDiv" class="formDiv">
				<h4>Fee Collection Management</h4>
				<br />
				<form action="/" method="POST" class="form-horizontal" role="form"
					enctype="utf8" id="Fc" autocomplete="off">
					<div class="form-group" style="display: none">				
						<div class="col-sm-6">
							<input type="text" class="form-control" id="fcId" name="id"> 
						</div>
						<div class="col-sm-6">
						</div>
					</div>				
					<div class="form-group">		
						<label class="control-label col-sm-2 req" for="fcen">Enter Enroll No</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="inputFc" name="enrollNo"
								placeholder="Enter Enroll No" required="required" onkeypress="handleEnterKey(event,'enter','findFc')"> 
						</div>
						<div class="col-sm-6">
							<button type="button" id="findFc" class="btn btn-success">
								<span class="glyphicon glyphicon-search"></span> <span>Search</span>
							</button>
	<!-- 						<button type="button" id="printFc" onclick="printFc2()" class="btn btn-success">
								<span class="glyphicon glyphicon-print"></span> Print
							</button>
	 -->					</div>
					</div>
					<div id="fcCalculaton" class="form-group" style="display: none">	
						<input type="number" class="form-control" id="fchf" min="0" name="fee"/> 
						<input type="number" class="form-control" id="fchvf" min="0" name="vehicleFee"/> 
						<input type="number" class="form-control" id="fchd" min="0" name="discount"/> 
						<input type="text" class="form-control" id="fchdt" name="discountType"/> 
						<input type="number" class="form-control" id="fchda" min="0" name="dueAmount"/> 
						<input type="text" class="form-control" id="fchdd" name="dueDayOfMonth"/>
					</div>			
					<div class="form-group" id="fcDetail">
						<table id="" class="display table" style="width:100%">
							<thead>
								<tr>
									<th>Student</th>
									<th>Guardian</th>
									<th>School</th>
									<th>Class</th>
									<th>Fee</th>
									<th>V. Fare</th>
									<th>Discount</th>
									<th>Due Amount</th>
									<th>Due Date</th>
								</tr>	
							</thead>
							<tbody>
								<tr>
									<td class="col-sm-2"><div class=" fcDTC" id="fcsn"></div></td>
									<td class="col-sm-2"><div class=" fcDTC" id="fcgn"></div></td>
									<td class="col-sm-2"><div class=" fcDTC" id="fcscn"></div></td>
									<td class="col-sm-1"><div class=" fcDTC" id="fcg"></div></td>
									<td class="col-sm-1"><div class=" fcDTC" id="fcf"></div></td>
									<td class="col-sm-1"><div class=" fcDTC" id="fcvf"></div></td>
									<td class="col-sm-1"><div class=" fcDTC" id="fcd"></div>
									<td class="col-sm-1"><div class=" fcDTC" id="fcda"></div></td>
									<td class="col-sm-1"><div class=" fcDTC" id="fcdd"></div></td>
								</tr>
							</tbody>						
						</table>
						<table id="fcDT" class="display table" style="width:100%">
							<thead>
								<tr><th rowspan="1" colspan="12" style="margin: 0px;padding: 3px">Fee details since last payment</th></tr>
								<tr>
									<th>Date</th>
									<th>Payer</th>
									<th>Payee</th>
									<th>Fee</th>
									<th>V. Fee</th>
									<th>Discount</th>
									<th>Other payment</th>
									<th>Other desc.</th>
									<th>Due Amount</th>
									<th>paid</th>
									<th>Balance</th>
								</tr>	
							</thead>
							<!-- <tbody>
								<tr role="row"><th rowspan="1" colspan="12" style="width: 100%;">Details since last payment</th></tr>
							</tbody> -->						
						</table>
						<!-- <table class="table" id="fcDT">
							<thead>
								<tr>
									<th>Student</th>
									<th>Gaurdian</th>
									<th>School</th>
