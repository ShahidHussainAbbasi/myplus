        <script src="/bootstrap/js/bootstrap-datepicker.min.js"></script>
        <script src="/js/main.js"></script>
        <!-- Global AJAX waiting overlay — one source for the whole app; blocks interaction while any
             $.ajax/$.post is in flight (see /js/common/ajax-overlay.js). -->
        <script src="/js/common/ajax-overlay.js"></script>
        <!-- App-themed confirm/prompt/alert (uiConfirm/uiPromptConfirm/uiAlert) — replaces the browser's
             unstyled window.confirm. Must load before the module scripts that call it. -->
        <script src="/js/common/confirm-dialog.js"></script>
        <!-- Contact-360 (cross-module contact view) — shared by business/education/welfare/pharmacy rows. -->
        <script src="/js/common/party-contact.js"></script>
        <!-- Focus flow: on these long dashboards, bring a revealed section / opened record / rejected field
             into view and land the cursor in it, so nobody hunts and scrolls. Desktop-only auto-focus. -->
        <script src="/js/common/focus-flow.js"></script>
        <!-- Date pickers: the app's own calendar, bound in ONE place (binding a second plugin to the same input
             is what cleared fields on blur). Zero dependencies — nothing to vendor. Emits exactly the
             dd-MM-yyyy / dd-MM-yyyy HH:mm:ss / dd-MMM-yyyy / MM-yyyy strings the services already parse. -->
        <script src="/js/common/date-picker.js"></script>
        <!-- Demo free-trial: surfaces the gateway's DEMO_LIMIT (50/module cap) as an upsell prompt. -->
        <script src="/js/demo.js"></script>
        <!-- Wide grids (Fee Register = 13 columns) were clipped by the mobile body overflow rule rather
             than scrollable. Wraps each table in its own scroller once, at DOM-ready. -->
        <script src="/js/common/responsive-tables.js"></script>
        <!-- Language menu affordance only — switching is a plain ?lang= link handled server-side. -->
        <script src="/js/common/lang-switcher.js"></script>
        <!-- The self-rendering Configuration screen, shared by all four dashboards. -->
        <script src="/js/common/settings-form.js"></script>
        <!-- CSRF: send the XSRF-TOKEN cookie back as the X-XSRF-TOKEN header on every state-changing
             AJAX call, so jQuery $.post/$.ajax pass Spring Security's CSRF check. -->
        <script>
        (function () {
            function readCookie(name) {
                var m = document.cookie.match('(?:^|; )' + name + '=([^;]*)');
                return m ? decodeURIComponent(m[1]) : null;
            }
            if (window.jQuery) {
                // ajaxSend fires for EVERY jQuery request and is not overridden by a per-call
                // beforeSend, so it reliably stamps the header even on calls with custom options.
                jQuery(document).ajaxSend(function (event, xhr, settings) {
                    if (!/^(GET|HEAD|OPTIONS|TRACE)$/i.test(settings.type || 'GET')) {
                        var token = readCookie('XSRF-TOKEN');
                        if (token) { xhr.setRequestHeader('X-XSRF-TOKEN', token); }
                    }
                });
            }
        })();
        </script>
    
 	</div>
	<script>
var serverContext = "\/";
	</script>
	<script type="text/javascript" src="/js/jspdf.min.js"></script>
	<script type="text/javascript" src="/js/jspdf.plugin.autotable.js"></script>

	<script src="/js/common/dom-safe.js"></script>
	<!-- Team & Users: the SAME screen the commerce dashboard uses. Locations for this vertical are BRANCHES
	     (schools), so the picker reads /getUserSchool; the grant endpoint resolves the module server-side. -->
	<script>window.TEAM_LOCATIONS_URL = 'getMySchools'; window.TEAM_LOCATION_NOUN = 'branch';</script>
	<script type="text/javascript" src="/js/common/team.js"></script>
	<script type="text/javascript" src="/js/common/org-switcher.js"></script>
	<script type="text/javascript" src="/js/lib/chart.umd.min.js"></script>
	<script type="text/javascript" src="/js/education/education.js"></script>
	<script type="text/javascript" src="/js/education/educationDashboard.js"></script>
	<script type="text/javascript" src="/js/date.js"></script>
	<script src="/js/business/sidebar.js"></script>
	<!-- Shared CRUD modal layer (openModal/closeModal/newEntity/bulk-select) — same as businessDashboard. -->
	<script src="/js/business/crud-modal.js"></script>
	<script type="text/javascript">
		// Subnav button-dropdown behaviour — same pattern as businessDashboard for a consistent look.
		function snavToggle(e, id) {
			e.stopPropagation();
			var d = document.getElementById(id);
			var was = d.classList.contains('snav-open');
			document.querySelectorAll('.snav-dd').forEach(function(el) { el.classList.remove('snav-open'); });
			if (!was) d.classList.add('snav-open');
		}
		function snavGo(sel, val, ddId) {
			document.querySelectorAll('.snav-btn').forEach(function(el) { el.classList.remove('snav-active'); });
			var btn = document.querySelector('#' + ddId + ' > .snav-btn');
			if (btn) btn.classList.add('snav-active');
			$('#' + sel).val(val).trigger('change');
			document.getElementById(ddId).classList.remove('snav-open');
		}
		// Click-away closing now lives in /js/business/sidebar.js — it spares the group holding the CURRENT
		// selection, so clicking into the form no longer collapses the nav item you are working under.
	</script>

	<!-- ═══ Unified dropdown theme/UX ═══════════════════════════════════════════
	     Make EVERY education form dropdown one consistent, searchable bootstrap-select.
	     Skips only the off-screen nav selects (registrationType/feeType/… driven by main.js).
	     Several AJAX populate helpers in education.js append <option>s without calling
	     selectpicker('refresh') (e.g. getUserOwners/getUserSchools), so a single ajaxComplete
	     refresh keeps every populated dropdown (schoolOwnerDD, vehicleSchoolDD, …) in sync. -->
	<script type="text/javascript">
		jQuery(function ($) {
			var SKIP = { registrationType:1, feeType:1, reportType:1, attendanceType:1, communicationType:1 };
			$('select').each(function () {
				if (SKIP[this.id] || $(this).hasClass('panel-heading')) return;
				var $s = $(this);
				// Tear down any prior bootstrap-select so the unified options below apply cleanly.
				// ONLY if one was actually initialised: calling destroy() on a plain <select> makes the
				// plugin bridge construct an instance and immediately destroy it, which removes the
				// generated wrapper *together with the original <select>*. That silently deleted every
				// education dropdown from the DOM on page load (the try/catch hid it).
				if ($s.data('selectpicker')) {
					try { $s.selectpicker('destroy'); } catch (e) {}
				}
				$s.addClass('selectpicker')
				  .attr('data-live-search', 'true')   // searchable
				  .attr('data-size', '8')
				  .attr('data-style', 'btn-default');
				if (this.multiple) {
					$s.attr('data-actions-box', 'true')
					  .attr('data-selected-text-format', 'count > 2');
				}
				if (!$s.attr('title')) $s.attr('title', 'Select…');
			});
			$('.selectpicker').selectpicker();
			// AJAX-populated dropdowns refresh after their options load (handles every getUser* helper).
			$(document).ajaxComplete(function () {
				try { $('.selectpicker').selectpicker('refresh'); } catch (e) {}
			});
		});
	</script>
</body>
</html>
