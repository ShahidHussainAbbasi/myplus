						<label class="control-label col-sm-2" for="studentDueDay">Due day of fee payment</label>
						<div class="col-sm-4">
							<input type="number" placeholder="default is 10" class="form-control" id="studentDueDay" name="dueDay"
							 min="0" max="31"> 						
						</div>
					</div>
	 				<div class="form-group">
