						<label class="control-label col-sm-2 req" for="studentName">Student Name</label>
						<div class="col-sm-4">
							<input type="text" class="form-control" id="studentName" name="name"
								placeholder="Student Name" required="required"> 
						</div>
						<label class="control-label col-sm-2 req" for="studentSchoolDD">Select Campus</label> 
						<div class="col-sm-4">
							<select class="form-control" id="studentSchoolDD" name="schoolId" required="required">
							</select>
						</div>
					</div>
					<div class="form-group">				
						<label class="control-label col-sm-2 req" for="studentGradeDD">Select Grade</label> 
