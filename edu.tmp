    <!-- Reset bar for the dev owner test account: it holds DEMO_RESET_PRIVILEGE but NOT DEMO_PRIVILEGE, so it
         is uncapped (no 50-entry message) yet can still wipe its own org back to a clean slate for a demo. -->
    
    <!-- Demo free-trial banner — shown only for demo accounts (DEMO_PRIVILEGE in the JWT). -->
    
    
	    <div id="content">
			<!-- Nav selects: off-screen so main.js change events fire and Cypress can reach them -->
			<div style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" aria-hidden="true">
				<select name="registrationType" id="registrationType" class="dropdown show panel-heading" tabindex="-1">
					<option value="">Manage Registrations</option>
					<option value="OwnerDiv">Owners</option>
					<option value="SchoolDiv">Campus</option>
					<option value="VehicleDiv">Vehicles</option>
					<option value="GradeDiv">Classes</option>
					<option value="AcademicYearDiv">Academic Year</option>
					<option value="ExamDiv">Examinations</option>
					<option value="MarksDiv">Marks Entry</option>
					<option value="GradingDiv">Grading Scale</option>
					<option value="ReportCardDiv">Report Cards</option>
					<option value="PromotionDiv">Promotion</option>
					<option value="TimetableDiv">Timetable</option>
					<option value="SubstitutionDiv">Substitution</option>
					<option value="StaffRegisterDiv">Staff Register</option>
					<option value="LeaveDiv">Leave</option>
					<option value="HomeworkDiv">Homework</option>
					<option value="MeetingsDiv">Parents&#39; evenings</option>
					<option value="NoticesDiv">Notices</option>
					<option value="BehaviourDiv">Behaviour</option>
					<option value="PortalAccessDiv">Guardian Portal Access</option>
					<option value="StaffDiv">Employee</option>
					<option value="SubjectDiv">Subjects</option>
					<option value="DiscountDiv">Manage Discounts/Charges</option>
					<option value="GuardianDiv">Guardians</option>
					<option value="StudentDiv">Manage Students</option>
				</select>
				<select name="feeType" id="feeType" class="dropdown show panel-heading" tabindex="-1">
					<option value="">Manage Fee</option>
					<option value="FcDiv">Fee Collection</option>
					<option value="FVDiv">Fee Voucher/Ledger</option>
					<option value="FRDiv">Fee Report</option>
					<option value="FeeSettingDiv">Fee Settings</option>
				</select>
				<select name="reportType" id="reportType" class="dropdown show panel-heading" tabindex="-1">
					<option value="">View Reports</option>
					<option value="FRDiv">Fee Report</option>
				</select>
				<select name="attendanceType" id="attendanceType" class="dropdown show panel-heading" tabindex="-1">
					<option value="">Manage Attendance</option>
					<option value="ADiv">Attendance</option>
				</select>
				<select name="communicationType" id="communicationType" class="dropdown show panel-heading" tabindex="-1">
					<option value="">Manage Alerts</option>
					<option value="PADiv">Public Alerts</option>
					<option value="AlertsDiv">System Alerts</option>
				</select>
			</div>
			<nav class="app-sidebar" id="app-sidebar"><div class="app-sidebar__brand"><span class="glyphicon glyphicon-th-large"></span><span class="app-sidebar__brand-text">MyPlus</span><button type="button" class="app-sidebar__toggle" onclick="toggleSidebar()" title="Collapse menu"><span class="glyphicon glyphicon-menu-hamburger"></span></button></div>
				<div class="container-fluid">
					<div class="snav-inner">
						<div class="snav-left">
							
						</div>
						<div class="snav-actions">
							<div class="snav-dd" id="snavRegister">
								<button class="snav-btn" onclick="snavToggle(event,'snavRegister')">
									<span class="glyphicon glyphicon-pencil"></span>
									<span>Register</span>
									<span class="snav-caret">&#9660;</span>
								</button>
								<ul class="snav-menu">
									<li><a onclick="snavGo('registrationType','OwnerDiv','snavRegister')"><span class="glyphicon glyphicon-user"></span> <span>Owners</span></a></li>
									<li><a onclick="snavGo('registrationType','SchoolDiv','snavRegister')"><span class="glyphicon glyphicon-home"></span> <span>Campus</span></a></li>
									<li><a onclick="snavGo('registrationType','VehicleDiv','snavRegister')"><span class="glyphicon glyphicon-road"></span> <span>Vehicles</span></a></li>
									<li><a onclick="snavGo('registrationType','GradeDiv','snavRegister')"><span class="glyphicon glyphicon-th-large"></span> <span>Classes</span></a></li>
									<!-- Slice 1.1: the academic spine — exams, marks and promotion all hang off a term. -->
									<li><a onclick="snavGo('registrationType','AcademicYearDiv','snavRegister')"><span class="glyphicon glyphicon-calendar"></span> <span>Academic Year</span></a></li>
									<li><a onclick="snavGo('registrationType','ExamDiv','snavRegister')"><span class="glyphicon glyphicon-list-alt"></span> <span>Examinations</span></a></li>
									<li><a onclick="snavGo('registrationType','MarksDiv','snavRegister')"><span class="glyphicon glyphicon-pencil"></span> <span>Marks Entry</span></a></li>
									<li><a onclick="snavGo('registrationType','GradingDiv','snavRegister')"><span class="glyphicon glyphicon-star"></span> <span>Grading Scale</span></a></li>
									<!-- Slice 1.5: preview is open (it shows the same marks the marksheet does); PUBLISHING is
									     ADMIN and enforced server-side, so this entry stays visible to teachers. -->
									<li><a onclick="snavGo('registrationType','ReportCardDiv','snavRegister')"><span class="glyphicon glyphicon-file"></span> <span>Report Cards</span></a></li>
									<!-- Slice 1.6: the most destructive operation in the product — ADMIN only, and the
									     server enforces it regardless of what this menu shows. -->
									<li><a onclick="snavGo('registrationType','PromotionDiv','snavRegister')"><span class="glyphicon glyphicon-circle-arrow-up"></span> <span>Promotion</span></a></li>
									<!-- Slice 2.1: everyone reads the timetable; only ADMIN edits it (enforced server-side). -->
									<li><a onclick="snavGo('registrationType','TimetableDiv','snavRegister')"><span class="glyphicon glyphicon-calendar"></span> <span>Timetable</span></a></li>
									<!-- Slice 2.2: everyone reads today's cover list; only ADMIN assigns it (enforced server-side). -->
									<li><a onclick="snavGo('registrationType','SubstitutionDiv','snavRegister')"><span class="glyphicon glyphicon-transfer"></span> <span>Substitution</span></a></li>
									<!-- Slice 2.3: the register is ADMIN (it decides who was paid to be here);
									     Leave is open because a teacher requests their own. -->
									<li><a onclick="snavGo('registrationType','StaffRegisterDiv','snavRegister')"><span class="glyphicon glyphicon-check"></span> <span>Staff Register</span></a></li>
									<li><a onclick="snavGo('registrationType','LeaveDiv','snavRegister')"><span class="glyphicon glyphicon-plane"></span> <span>Leave</span></a></li>
									<!-- Slice 2.4: teacher work (WRITE tier), like marks entry — not the ADMIN policy tier. -->
									<li><a onclick="snavGo('registrationType','HomeworkDiv','snavRegister')"><span class="glyphicon glyphicon-book"></span> <span>Homework</span></a></li>
									<!-- Slice 2.5: teacher work (WRITE tier). Notes are append-only — there is no edit
									     or delete anywhere in the stack. -->
									<li><a onclick="snavGo('registrationType','MeetingsDiv','snavRegister')"><span class="glyphicon glyphicon-calendar"></span> <span>Parents&#39; evenings</span></a></li>
									<li><a onclick="snavGo('registrationType','NoticesDiv','snavRegister')"><span class="glyphicon glyphicon-bullhorn"></span> <span>Notices</span></a></li>
									<li><a onclick="snavGo('registrationType','BehaviourDiv','snavRegister')"><span class="glyphicon glyphicon-flag"></span> <span>Behaviour</span></a></li>
									<!-- Slice 3.1: granting an OUTSIDER sight of a child's record is ADMIN policy,
									     the same tier as fee settings — never day-to-day teacher work. -->
									<li><a onclick="snavGo('registrationType','PortalAccessDiv','snavRegister')"><span class="glyphicon glyphicon-log-in"></span> <span>Guardian Portal Access</span></a></li>
									<li><a onclick="snavGo('registrationType','StaffDiv','snavRegister')"><span class="glyphicon glyphicon-briefcase"></span> <span>Employee</span></a></li>
									<li><a onclick="snavGo('registrationType','SubjectDiv','snavRegister')"><span class="glyphicon glyphicon-book"></span> <span>Subjects</span></a></li>
									<li><a onclick="snavGo('registrationType','DiscountDiv','snavRegister')"><span class="glyphicon glyphicon-tags"></span> <span>Manage Discounts/Charges</span></a></li>
									<li><a onclick="snavGo('registrationType','GuardianDiv','snavRegister')"><span class="glyphicon glyphicon-user"></span> <span>Guardians</span></a></li>
									<li><a onclick="snavGo('registrationType','StudentDiv','snavRegister')"><span class="glyphicon glyphicon-education"></span> <span>Manage Students</span></a></li>
									<!-- P4: add teachers/admins and assign them to branches (the education twin of the POS
									     Manage Users screen; showTeam lives in /js/common/team.js). -->
									<li><a onclick="showTeam();document.getElementById('snavRegister').classList.remove('snav-open');"><span class="glyphicon glyphicon-list-alt"></span> <span>Manage Users</span></a></li>
								</ul>
							</div>
							<div class="snav-dd" id="snavFee">
								<button class="snav-btn" onclick="snavToggle(event,'snavFee')">
									<span class="glyphicon glyphicon-usd"></span>
									<span>Fee</span>
									<span class="snav-caret">&#9660;</span>
								</button>
								<ul class="snav-menu">
									<li><a onclick="snavGo('feeType','FcDiv','snavFee')"><span class="glyphicon glyphicon-plus-sign"></span> <span>Fee Collection</span></a></li>
									<li><a onclick="snavGo('feeType','FVDiv','snavFee')"><span class="glyphicon glyphicon-list-alt"></span> <span>Fee Voucher/Ledger</span></a></li>
									<li><a onclick="snavGo('feeType','FRDiv','snavFee')"><span class="glyphicon glyphicon-stats"></span> <span>Fee Report</span></a></li>
									<li><a onclick="snavGo('feeType','FeeSettingDiv','snavFee')"><span class="glyphicon glyphicon-cog"></span> <span>Fee Settings</span></a></li>
									<!-- Slice 0.2a/0.2b: receivables views over the shared subledger engines. -->
									<li><a onclick="showFeeAging()"><span class="glyphicon glyphicon-time"></span> <span>Fee Arrears</span></a></li>
									<li><a onclick="showFeeStatement()"><span class="glyphicon glyphicon-list-alt"></span> <span>Student Statement</span></a></li>
									<!-- Owner Configuration: the generic per-tenant settings screen (branch policies etc.). -->
									<li><a onclick="showConfig();document.getElementById('snavFee').classList.remove('snav-open');"><span class="glyphicon glyphicon-wrench"></span> <span>Configuration</span></a></li>
								</ul>
							</div>
							<div class="snav-dd" id="snavReport">
								<button class="snav-btn" onclick="snavToggle(event,'snavReport')">
									<span class="glyphicon glyphicon-stats"></span>
									<span>Reports</span>
									<span class="snav-caret">&#9660;</span>
								</button>
								<ul class="snav-menu">
									<li><a onclick="snavGo('reportType','FRDiv','snavReport')"><span class="glyphicon glyphicon-file"></span> <span>Fee Report</span></a></li>
								</ul>
							</div>
							<div class="snav-dd" id="snavAttendance">
								<button class="snav-btn" onclick="snavToggle(event,'snavAttendance')">
									<span class="glyphicon glyphicon-check"></span>
									<span>Attendance</span>
									<span class="snav-caret">&#9660;</span>
								</button>
								<ul class="snav-menu">
									<li><a onclick="snavGo('attendanceType','ADiv','snavAttendance')"><span class="glyphicon glyphicon-ok"></span> <span>Attendance</span></a></li>
								</ul>
							</div>
							<div class="snav-dd" id="snavAlerts">
								<button class="snav-btn" onclick="snavToggle(event,'snavAlerts')">
									<span class="glyphicon glyphicon-bell"></span>
									<span>Alerts</span>
									<span class="snav-caret">&#9660;</span>
								</button>
								<ul class="snav-menu">
									<li><a onclick="snavGo('communicationType','PADiv','snavAlerts')"><span class="glyphicon glyphicon-bullhorn"></span> <span>Public Alerts</span></a></li>
									<li><a onclick="snavGo('communicationType','AlertsDiv','snavAlerts')"><span class="glyphicon glyphicon-envelope"></span> <span>System Alerts</span></a></li>
								</ul>
							</div>
							<!-- Active-organization (tenant) switcher. Populated from /getMyOrganizations;
							     changing it re-issues the session JWT scoped to the chosen org. -->
							<span id="orgSwitcherLi" class="snav-org">
								<select name="orgSwitcher" id="orgSwitcher" title="Active organization" class="snav-org-select"
									style="height:32px;border-radius:6px;border:none;padding:0 8px;margin-left:8px;">
									<option value="">Organization…</option>
								</select>
							</span>
							<!-- P4 active-branch (school) switcher — the education twin of the POS store switcher.
							     Hidden unless the user can work at 2+ branches. Changing it re-issues the session
							     JWT with the chosen branch, which is what new students/grades are filed under. -->
							<span id="branchSwitcherLi" class="snav-org" style="display:none">
								<select name="branchSwitcher" id="branchSwitcher" title="Active branch" class="snav-org-select"
									style="height:32px;border-radius:6px;border:none;padding:0 8px;margin-left:8px;">
