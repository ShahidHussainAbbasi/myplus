                         + "be changed — those entries are in the accounts and moving the date would silently "
                         + "re-date them. Reverse the opening balances first if the date was wrong.");
     }
+
+    /** Any customer or supplier opening balance still recorded for this business (a reversal deletes the row). */
+    private boolean openingBalancesRecorded(Long organizationId) {
+        if (organizationId == null) return false;
+        return customerHistoryRepo.existsByOrganizationIdAndDocType(organizationId, OpeningBalanceService.DOC_OPENING)
+                || purchaseRepo.existsByOrganizationIdAndDocType(organizationId, OpeningBalanceService.DOC_OPENING);
+    }
 }
