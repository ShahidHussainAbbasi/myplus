     @Override
     public void check(Long organizationId, String key, String value) {
+        /*
+         * SET-GUIDE — the LOCK itself. It used to be an ordinary switch (and, with Reset to default, one click):
+         * switching it off let the date below change while opening balances sat in the ledger dated by it —
+         * silently re-dating them. So it may come off only when no opening balance is recorded any more; the
+         * documented path is "reverse the opening balances first". Reset lands on the default (off), so the same
+         * rule refuses it (SettingWriteGuard.checkReset delegates here with the default).
+         */
+        if (OpeningBalanceService.LOCKED_KEY.equals(key)) {
+            boolean unlocking = value == null || !"true".equalsIgnoreCase(value.trim());
+            if (unlocking && openingBalancesRecorded(organizationId)) {
+                throw new IllegalArgumentException(
+                        "Opening balances are recorded against the cutover date, so the lock cannot come off — "
+                                + "moving the date would re-date entries already in the accounts. Reverse the "
+                                + "opening balances first; the lock can then be switched off.");
+            }
+            return;
+        }
         if (!OpeningBalanceService.CUTOVER_KEY.equals(key)) return;   // not our key, not our business
 
         boolean locked = settings != null && settings.getBool(OpeningBalanceService.LOCKED_KEY);
